procedure ssend(int __mn_mem0, int __mn_mem1, int __mn_mem2, int __mn_mem3, int __mn_mem4, int __mn_mem5, int __mn_mem6, int __mn_mem7, int __mn_mem8, int __mn_mem9)
    stack __mn_hist
    local int __mn_e0 = 0
        // funzione C ssend
        push(__mn_mem2, __mn_hist)
        __mn_mem2 += __mn_mem4
        push(__mn_mem0, __mn_hist)
        __mn_mem0 += 1
        if __mn_mem1 == 0 then
            push(__mn_e0, __mn_hist)
            __mn_e0 += 1
        fi __mn_mem1 == 0
        from __mn_e0 != 0 loop
            push(__mn_e0, __mn_hist)
            __mn_e0 += 0
            if __mn_mem1 == 0 then
                push(__mn_e0, __mn_hist)
                __mn_e0 += 1
            fi __mn_mem1 == 0
        until __mn_e0 == 0
    push(__mn_e0, __mn_hist)
    delocal int __mn_e0 = 0
procedure srecv(int __mn_mem0, int __mn_mem1, int __mn_mem2, int __mn_mem3, int __mn_mem4, int __mn_mem5, int __mn_mem6, int __mn_mem7, int __mn_mem8, int __mn_mem9)
    stack __mn_hist
    local int __mn_e0 = 0
        // funzione C srecv
        if __mn_mem0 == 0 then
            push(__mn_e0, __mn_hist)
            __mn_e0 += 1
        fi __mn_mem0 == 0
        from __mn_e0 != 0 loop
            push(__mn_e0, __mn_hist)
            __mn_e0 += 0
            if __mn_mem0 == 0 then
                push(__mn_e0, __mn_hist)
                __mn_e0 += 1
            fi __mn_mem0 == 0
        until __mn_e0 == 0
        push(__mn_mem3, __mn_hist)
        __mn_mem3 += __mn_mem2
        push(__mn_mem1, __mn_hist)
        __mn_mem1 += 1
    push(__mn_e0, __mn_hist)
    delocal int __mn_e0 = 0
