// Pool puntatori Mnemo — generato, N=4 celle (__mn_mem0..__mn_mem3).
// `__mn_pool_free`: azzera cella; se slot è l’ultima alloc (LIFO), dec ctr.

procedure __mn_pool_alloc(int ctr, int out_slot)
    stack __mn_hist
    local int t = 0
        t += ctr
        push(ctr, __mn_hist)
        ctr += 1
        push(out_slot, __mn_hist)
        out_slot += t
        push(t, __mn_hist)
    delocal int t = 0

procedure __mn_pool_store(int slot, int val, int __mn_mem0, int __mn_mem1, int __mn_mem2, int __mn_mem3)
    stack __mn_hist
    if slot == 0 then
        push(__mn_mem0, __mn_hist)
        __mn_mem0 += val
    fi slot == 0
    if slot == 1 then
        push(__mn_mem1, __mn_hist)
        __mn_mem1 += val
    fi slot == 1
    if slot == 2 then
        push(__mn_mem2, __mn_hist)
        __mn_mem2 += val
    fi slot == 2
    if slot == 3 then
        push(__mn_mem3, __mn_hist)
        __mn_mem3 += val
    fi slot == 3

procedure __mn_pool_load(int slot, int __mn_mem0, int __mn_mem1, int __mn_mem2, int __mn_mem3, int out)
    stack __mn_hist
    if slot == 0 then
        local int t = 0
            t += __mn_mem0
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 0
    if slot == 1 then
        local int t = 0
            t += __mn_mem1
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 1
    if slot == 2 then
        local int t = 0
            t += __mn_mem2
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 2
    if slot == 3 then
        local int t = 0
            t += __mn_mem3
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 3

procedure __mn_pool_free(int slot, int __mn_mem0, int __mn_mem1, int __mn_mem2, int __mn_mem3, int ctr)
    stack __mn_hist
    local int ctr0 = 0
        ctr0 += ctr
        if slot == 0 then
            push(__mn_mem0, __mn_hist)
        fi slot == 0
        if slot == 1 then
            push(__mn_mem1, __mn_hist)
        fi slot == 1
        if slot == 2 then
            push(__mn_mem2, __mn_hist)
        fi slot == 2
        if slot == 3 then
            push(__mn_mem3, __mn_hist)
        fi slot == 3
        if slot == 0 then
            if ctr0 == 1 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 1
        fi slot == 0
        if slot == 1 then
            if ctr0 == 2 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 2
        fi slot == 1
        if slot == 2 then
            if ctr0 == 3 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 3
        fi slot == 2
        if slot == 3 then
            if ctr0 == 4 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 4
        fi slot == 3
        push(ctr0, __mn_hist)
    delocal int ctr0 = 0

procedure main()
    stack __mn_hist
    stack __mn_scratch
    local int argc = 0
    local int argv = 0
    local int __mn_mem0 = 0
    local int __mn_mem1 = 0
    local int __mn_mem2 = 0
    local int __mn_mem3 = 0
    local int __mn_pool_ctr = 0
    local int p = 0
    local int __mn_e0 = 0
        // generato da Mnemo da C
        argc += 17
        argv += 0
        call __mn_pool_alloc(__mn_pool_ctr, __mn_e0)
        push(p, __mn_hist)
        p += __mn_e0
        push(__mn_e0, __mn_scratch)
        call __mn_pool_store(p, argc, __mn_mem0, __mn_mem1, __mn_mem2, __mn_mem3)
        call __mn_pool_free(p, __mn_mem0, __mn_mem1, __mn_mem2, __mn_mem3, __mn_pool_ctr)
        // return
    push(__mn_e0, __mn_hist)
    delocal int __mn_e0 = 0
    push(p, __mn_hist)
    delocal int p = 0
    push(__mn_pool_ctr, __mn_hist)
    delocal int __mn_pool_ctr = 0
    push(__mn_mem3, __mn_hist)
    delocal int __mn_mem3 = 0
    push(__mn_mem2, __mn_hist)
    delocal int __mn_mem2 = 0
    push(__mn_mem1, __mn_hist)
    delocal int __mn_mem1 = 0
    push(__mn_mem0, __mn_hist)
    delocal int __mn_mem0 = 0
    push(argv, __mn_hist)
    delocal int argv = 0
    push(argc, __mn_hist)
    delocal int argc = 0
