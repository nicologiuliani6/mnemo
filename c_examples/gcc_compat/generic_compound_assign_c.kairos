// Sposta il valore di src in dst (src azzerato) usando uno stack locale come "garbage" / condotto.
// La VM implementa `pop(dst, …)` come `*dst += valore`: per sostituire dst, azzeralo prima con
// `push(dst, hist)` sullo stack Janus del caller, poi `call __mn_move_int(dst, src)`.
procedure __mn_move_int(int dst, int src)
    local stack __mn_g = nil
    push(src, __mn_g)
    pop(dst, __mn_g)
    delocal stack __mn_g = nil

// Prodotto: dst += a * b usando solo somme ripetute (Kairos non ha *).
// b deve essere >= 0; a e b non vengono distrutti. (b == 0 → nessuna iterazione.)
procedure __mn_mul_into(int dst, int a, int b)
    local int i = 0
    from i < b loop
        i += 1
        dst += a
    until i == b
    delocal int i = b

// Divisione e resto: a, b interi con a >= 0 e b > 0; q = 0 e r = 0 all'ingresso.
// Uscita: q = a/b, r = a%b, a = 0. Il dividendo viene spostato in r via __mn_move_int (stack locale).
procedure __mn_divmod_nonneg(int a, int b, int q, int r)
    call __mn_move_int(r, a)
    from r >= b loop
        r -= b
        q += 1
    until r < b

// Operazioni bitwise via aritmetica (Kairos non ha &, |, <<, >>).
// Richiede helpers.kairos, mul.kairos, divmod.kairos.
// Convenzione: gli *_into fanno dst += f(...) assumendo dst partenza dal caller.

// Chiamate con divisore 2: le `call` Kairos accettano solo identificatori, non `2` letterale.
procedure __mn_divmod_nonneg_div2(int a, int q, int r)
    local int two = 0
    two += 1
    two += 1
    call __mn_divmod_nonneg(a, two, q, r)
    delocal int two = 2

// q = floor(t/2) con semantica divisione intera C su int; azzera t.
procedure __mn_floor_div2_signed(int t, int q)
    stack __mn_hist
    local int r = 0
    if t >= 0 then
        call __mn_divmod_nonneg_div2(t, q, r)
    else
        local int u = 0
        u -= t
        u += 1
        call __mn_divmod_nonneg_div2(u, q, r)
        local int z = 0
        z -= q
        push(q, __mn_hist)
        call __mn_move_int(q, z)
        local int sink = 0
        call __mn_move_int(sink, t)
        push(sink, __mn_hist)
        delocal int sink = 0
        push(z, __mn_hist)
        delocal int z = 0
        push(u, __mn_hist)
        delocal int u = 0
    fi t >= 0
    push(r, __mn_hist)
    delocal int r = 0

// Bit k (0=LSB) dopo k shift aritmetici su a (semantica come int C).
procedure __mn_bit_k_signed(int a, int k, int bit_out)
    stack __mn_hist
    local int t = 0
    t += a
    local int i = 0
    from i < k loop
        i += 1
        local int q = 0
        call __mn_floor_div2_signed(t, q)
        t += q
        push(q, __mn_hist)
        delocal int q = 0
    until i == k
    local int qf = 0
    local int rf = 0
    if t >= 0 then
        call __mn_divmod_nonneg_div2(t, qf, rf)
        bit_out += rf
    else
        local int u = 0
        u -= t
        call __mn_divmod_nonneg_div2(u, qf, rf)
        bit_out += rf
        push(u, __mn_hist)
        delocal int u = 0
    fi t >= 0
    push(rf, __mn_hist)
    delocal int rf = 0
    push(qf, __mn_hist)
    delocal int qf = 0
    push(i, __mn_hist)
    delocal int i = 0
    push(t, __mn_hist)
    delocal int t = 0

// dst += (a & b) — bit-a-bit su 31 iterazioni (LSB… , come interi con bit signed).
procedure __mn_and_into(int dst, int a, int b)
    stack __mn_hist
    local int k = 0
    local int pow = 1
    from k < 31 loop
        local int abit = 0
        local int bbit = 0
        call __mn_bit_k_signed(a, k, abit)
        call __mn_bit_k_signed(b, k, bbit)
        if abit != 0 then
            if bbit != 0 then
                dst += pow
            fi bbit != 0
        fi abit != 0
        k += 1
        local int next_pow = 0
        next_pow += pow
        next_pow += pow
        push(pow, __mn_hist)
        call __mn_move_int(pow, next_pow)
        push(next_pow, __mn_hist)
        delocal int next_pow = 0
        push(bbit, __mn_hist)
        delocal int bbit = 0
        push(abit, __mn_hist)
        delocal int abit = 0
    until k == 31
    push(pow, __mn_hist)
    delocal int pow = 0
    push(k, __mn_hist)
    delocal int k = 0

// dst += (a | b)
procedure __mn_or_into(int dst, int a, int b)
    stack __mn_hist
    local int k = 0
    local int pow = 1
    from k < 31 loop
        local int abit = 0
        local int bbit = 0
        call __mn_bit_k_signed(a, k, abit)
        call __mn_bit_k_signed(b, k, bbit)
        local int s = 0
        s += abit
        s += bbit
        if s != 0 then
            dst += pow
        fi s != 0
        k += 1
        local int next_pow = 0
        next_pow += pow
        next_pow += pow
        push(pow, __mn_hist)
        call __mn_move_int(pow, next_pow)
        push(next_pow, __mn_hist)
        delocal int next_pow = 0
        push(s, __mn_hist)
        delocal int s = 0
        push(bbit, __mn_hist)
        delocal int bbit = 0
        push(abit, __mn_hist)
        delocal int abit = 0
    until k == 31
    push(pow, __mn_hist)
    delocal int pow = 0
    push(k, __mn_hist)
    delocal int k = 0

// dst += (x << n), n >= 0
// `pop` nella VM fa `dst += valore`: prima di __mn_move_int(dst, src) va azzerato
// `dst` con push(dst, stack), altrimenti pow diventa 1+2=3 e x<<1 diventa x*3.
procedure __mn_shl_into(int dst, int x, int n)
    stack __mn_hist
    local int pow = 1
    local int i = 0
    from i < n loop
        i += 1
        local int np = 0
        np += pow
        np += pow
        push(pow, __mn_hist)
        call __mn_move_int(pow, np)
        push(np, __mn_hist)
        delocal int np = 0
    until i == n
    call __mn_mul_into(dst, x, pow)
    push(i, __mn_hist)
    delocal int i = 0
    push(pow, __mn_hist)
    delocal int pow = 0

// dst += (x >> n) aritmetico
procedure __mn_shr_into(int dst, int x, int n)
    stack __mn_hist
    local int t = 0
    t += x
    local int i = 0
    from i < n loop
        i += 1
        local int q = 0
        call __mn_floor_div2_signed(t, q)
        t += q
        push(q, __mn_hist)
        delocal int q = 0
    until i == n
    dst += t
    push(i, __mn_hist)
    delocal int i = 0
    push(t, __mn_hist)
    delocal int t = 0

// Stampa intero con segno (show byte, char). Dipendenze: helpers.kairos, divmod.kairos, mul.kairos.
// Dopo le cifre, n viene ricostruito con __mn_mul_into (niente uncall su divmod).

procedure __mn_putd_uint(int n)
    local int ten = 0
    ten += 10
    local int qu = 0
    local int rem = 0
    if n >= ten then
        call __mn_divmod_nonneg(n, ten, qu, rem)
        call __mn_putd_uint(qu)
        local int ch = 0
        ch += rem
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= rem
        delocal int ch = 0
        local int prod = 0
        call __mn_mul_into(prod, qu, ten)
        n += prod
        n += rem
        from prod > 0 loop
            prod -= 1
        until prod == 0
        from qu > 0 loop
            qu -= 1
        until qu == 0
        from rem > 0 loop
            rem -= 1
        until rem == 0
        delocal int prod = 0
    else
        local int ch = 0
        ch += n
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= n
        delocal int ch = 0
    fi n >= ten
    ten -= 10
    delocal int rem = 0
    delocal int qu = 0
    delocal int ten = 0

procedure __mn_putd(int n)
    local int z = 0
    if n < z then
        local int hy = 0
        hy += 45
        show(hy, char)
        hy -= 45
        delocal int hy = 0
        local int t = 0
        t -= n
        n += t
        n <=> t
        delocal int t = 0
        call __mn_putd_uint(n)
        local int t2 = 0
        t2 -= n
        n += t2
        n <=> t2
        delocal int t2 = 0
    else
        call __mn_putd_uint(n)
    fi n < z
    delocal int z = 0

// Stampa intero non negativo in esadecimale minuscolo.
// Dipendenze: helpers.kairos, divmod.kairos, mul.kairos.

procedure __mn_putx_uint(int n)
    local int base = 0
    base += 16
    local int qu = 0
    local int rem = 0
    if n >= base then
        call __mn_divmod_nonneg(n, base, qu, rem)
        call __mn_putx_uint(qu)
        local int ch = 0
        local int ten = 0
        ten += 10
        if rem >= ten then
            ch += rem
            ch += 87
            show(ch, char)
            ch -= 87
            ch -= rem
        else
            ch += rem
            ch += 48
            show(ch, char)
            ch -= 48
            ch -= rem
        fi rem >= ten
        ten -= 10
        delocal int ten = 0
        delocal int ch = 0
        local int prod = 0
        call __mn_mul_into(prod, qu, base)
        n += prod
        n += rem
        from prod > 0 loop
            prod -= 1
        until prod == 0
        from qu > 0 loop
            qu -= 1
        until qu == 0
        from rem > 0 loop
            rem -= 1
        until rem == 0
        delocal int prod = 0
    else
        local int ch = 0
        local int ten = 0
        ten += 10
        if n >= ten then
            ch += n
            ch += 87
            show(ch, char)
            ch -= 87
            ch -= n
        else
            ch += n
            ch += 48
            show(ch, char)
            ch -= 48
            ch -= n
        fi n >= ten
        ten -= 10
        delocal int ten = 0
        delocal int ch = 0
    fi n >= base
    base -= 16
    delocal int rem = 0
    delocal int qu = 0
    delocal int base = 0

procedure __mn_putx(int n)
    call __mn_putx_uint(n)

// Pool puntatori Mnemo — generato, N=5 celle (__mn_mem0..__mn_mem4).
// `__mn_pool_free`: azzera cella; se slot è l’ultima alloc (LIFO), dec ctr.
// `__mn_pool_alloc`: non fare push(ctr) prima di ctr+=1 — la VM azzera ctr al push
// e il secondo malloc vedrebbe un contatore corrotto (handle duplicati / slot errati).

procedure __mn_pool_alloc(int ctr, int out_slot)
    stack __mn_hist
    local int t = 0
        t += ctr
        push(out_slot, __mn_hist)
        out_slot += t
        ctr += 1
        push(t, __mn_hist)
    delocal int t = 0

procedure __mn_pool_store(int slot, int val, int __mn_mem0, int __mn_mem1, int __mn_mem2, int __mn_mem3, int __mn_mem4)
    stack __mn_hist
    if slot == 0 then
        push(__mn_mem0, __mn_hist)
        __mn_mem0 += val
    fi slot == 0
    if slot == 1 then
        push(__mn_mem1, __mn_hist)
        __mn_mem1 += val
    fi slot == 1
    if slot == 2 then
        push(__mn_mem2, __mn_hist)
        __mn_mem2 += val
    fi slot == 2
    if slot == 3 then
        push(__mn_mem3, __mn_hist)
        __mn_mem3 += val
    fi slot == 3
    if slot == 4 then
        push(__mn_mem4, __mn_hist)
        __mn_mem4 += val
    fi slot == 4

procedure __mn_pool_load(int slot, int __mn_mem0, int __mn_mem1, int __mn_mem2, int __mn_mem3, int __mn_mem4, int out)
    stack __mn_hist
    if slot == 0 then
        local int t = 0
            t += __mn_mem0
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 0
    if slot == 1 then
        local int t = 0
            t += __mn_mem1
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 1
    if slot == 2 then
        local int t = 0
            t += __mn_mem2
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 2
    if slot == 3 then
        local int t = 0
            t += __mn_mem3
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 3
    if slot == 4 then
        local int t = 0
            t += __mn_mem4
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 4

procedure __mn_pool_free(int slot, int __mn_mem0, int __mn_mem1, int __mn_mem2, int __mn_mem3, int __mn_mem4, int ctr)
    stack __mn_hist
    local int ctr0 = 0
        ctr0 += ctr
        if slot == 0 then
            push(__mn_mem0, __mn_hist)
        fi slot == 0
        if slot == 1 then
            push(__mn_mem1, __mn_hist)
        fi slot == 1
        if slot == 2 then
            push(__mn_mem2, __mn_hist)
        fi slot == 2
        if slot == 3 then
            push(__mn_mem3, __mn_hist)
        fi slot == 3
        if slot == 4 then
            push(__mn_mem4, __mn_hist)
        fi slot == 4
        if slot == 0 then
            if ctr0 == 1 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 1
        fi slot == 0
        if slot == 1 then
            if ctr0 == 2 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 2
        fi slot == 1
        if slot == 2 then
            if ctr0 == 3 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 3
        fi slot == 2
        if slot == 3 then
            if ctr0 == 4 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 4
        fi slot == 3
        if slot == 4 then
            if ctr0 == 5 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 5
        fi slot == 4
        push(ctr0, __mn_hist)
    delocal int ctr0 = 0

procedure main()
    stack __mn_hist
    stack __mn_scratch
    local int __mn_mem0 = 0
    local int __mn_mem1 = 0
    local int __mn_mem2 = 0
    local int __mn_mem3 = 0
    local int __mn_mem4 = 0
    local int __mn_exit = 0
    local int __mn_pool_ctr = 0
    local int __mn_e0 = 0
    local int __mn_e1 = 0
    local int __mn_e2 = 0
    local int __mn_e3 = 0
    local int __mn_e4 = 0
    local int __mn_e5 = 0
    local int __mn_e6 = 0
    local int __mn_e7 = 0
    local int __mn_e8 = 0
    local int __mn_e9 = 0
    local int __mn_e10 = 0
        // generato da Mnemo da C
        __mn_pool_ctr += 1
        push(__mn_mem0, __mn_hist)
        __mn_mem0 += 15
        push(__mn_e0, __mn_hist)
        __mn_e0 += __mn_mem0
        __mn_e0 ^= 31
        push(__mn_mem0, __mn_hist)
        __mn_mem0 += __mn_e0
        push(__mn_e0, __mn_scratch)
        push(__mn_e1, __mn_hist)
        __mn_e1 += __mn_mem0
        __mn_e1 ^= 7
        push(__mn_mem0, __mn_hist)
        __mn_mem0 += __mn_e1
        push(__mn_e1, __mn_scratch)
        __mn_e2 += 1
        call __mn_shl_into(__mn_e3, __mn_mem0, __mn_e2)
        push(__mn_e2, __mn_scratch)
        push(__mn_mem0, __mn_hist)
        __mn_mem0 += __mn_e3
        push(__mn_e3, __mn_scratch)
        __mn_e4 += 1
        call __mn_shr_into(__mn_e5, __mn_mem0, __mn_e4)
        push(__mn_e4, __mn_scratch)
        push(__mn_mem0, __mn_hist)
        __mn_mem0 += __mn_e5
        push(__mn_e5, __mn_scratch)
        __mn_e6 += 7
        call __mn_and_into(__mn_e7, __mn_mem0, __mn_e6)
        push(__mn_e6, __mn_scratch)
        push(__mn_mem0, __mn_hist)
        __mn_mem0 += __mn_e7
        push(__mn_e7, __mn_scratch)
        __mn_e8 += 8
        call __mn_or_into(__mn_e9, __mn_mem0, __mn_e8)
        push(__mn_e8, __mn_scratch)
        push(__mn_mem0, __mn_hist)
        __mn_mem0 += __mn_e9
        push(__mn_e9, __mn_scratch)
        call __mn_putd(__mn_mem0)
        __mn_e10 += 10
        show(__mn_e10, char)
        __mn_e10 -= 10
        push(__mn_e10, __mn_scratch)
        push(__mn_exit, __mn_hist)
        __mn_exit += __mn_mem0
        show(__mn_exit)
        // return
    push(__mn_e10, __mn_hist)
    delocal int __mn_e10 = 0
    push(__mn_e9, __mn_hist)
    delocal int __mn_e9 = 0
    push(__mn_e8, __mn_hist)
    delocal int __mn_e8 = 0
    push(__mn_e7, __mn_hist)
    delocal int __mn_e7 = 0
    push(__mn_e6, __mn_hist)
    delocal int __mn_e6 = 0
    push(__mn_e5, __mn_hist)
    delocal int __mn_e5 = 0
    push(__mn_e4, __mn_hist)
    delocal int __mn_e4 = 0
    push(__mn_e3, __mn_hist)
    delocal int __mn_e3 = 0
    push(__mn_e2, __mn_hist)
    delocal int __mn_e2 = 0
    push(__mn_e1, __mn_hist)
    delocal int __mn_e1 = 0
    push(__mn_e0, __mn_hist)
    delocal int __mn_e0 = 0
    push(__mn_pool_ctr, __mn_hist)
    delocal int __mn_pool_ctr = 0
    push(__mn_exit, __mn_hist)
    delocal int __mn_exit = 0
    push(__mn_mem4, __mn_hist)
    delocal int __mn_mem4 = 0
    push(__mn_mem3, __mn_hist)
    delocal int __mn_mem3 = 0
    push(__mn_mem2, __mn_hist)
    delocal int __mn_mem2 = 0
    push(__mn_mem1, __mn_hist)
    delocal int __mn_mem1 = 0
    push(__mn_mem0, __mn_hist)
    delocal int __mn_mem0 = 0
