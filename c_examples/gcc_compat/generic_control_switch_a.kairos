// Sposta il valore di src in dst (src azzerato) usando uno stack locale come "garbage" / condotto.
// La VM implementa `pop(dst, …)` come `*dst += valore`: per sostituire dst, azzeralo prima con
// `push(dst, hist)` sullo stack Janus del caller, poi `call __mn_move_int(dst, src)`.
procedure __mn_move_int(int dst, int src, stack __mn_hist, stack __mn_scratch)
    local stack __mn_g = nil
    push(src, __mn_g)
    pop(dst, __mn_g)
    delocal stack __mn_g = nil

// Prodotto: dst += a * b usando solo somme ripetute (Kairos non ha *).
// b deve essere >= 0; a e b non vengono distrutti. (b == 0 → nessuna iterazione.)
// `from i == 0` (non `< b`): FROM vero solo allo stato pre-loop (i=0),
// falso agli stati intermedi (i=1..b-1) — necessario per l'inversione Kairos.
procedure __mn_mul_into(int dst, int a, int b, stack __mn_hist, stack __mn_scratch)
    local int i = 0
    if b != 0 then
        from i == 0 loop
            i += 1
            dst += a
        until i == b
    fi b != 0
    delocal int i = b

// Prodotto signed: dst += a * b dove b può essere negativo.
// Reversibile: guard `b < z` non si modifica nel body (b e z immutabili).
procedure __mn_mul_signed_into(int dst, int a, int b, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    local int abs_b = 0
    if b < z then
        abs_b -= b
    else
        abs_b += b
    fi b < z
    call __mn_mul_into(dst, a, abs_b, __mn_hist, __mn_scratch)
    if b < z then
        local int t = 0
        t -= dst
        dst += t
        dst <=> t
        delocal int t = 0
    fi b < z
    if b < z then
        abs_b += b
    else
        abs_b -= b
    fi b < z
    delocal int abs_b = 0
    delocal int z = 0

// Divisione e resto: a, b interi con a >= 0 e b > 0; q = 0 e r = 0 all'ingresso.
// Uscita: q = a/b, r = a%b, a = 0. Il dividendo viene spostato in r via __mn_move_int (stack locale).
// `from q == 0`: FROM vero solo quando q=0 (pre-loop); falso a q=1,2,... (stati intermedi).
// `saved_r` copia a per il guard `if/fi`: la condizione non cambia durante il corpo.
procedure __mn_divmod_nonneg(int a, int b, int q, int r, stack __mn_hist, stack __mn_scratch)
    call __mn_move_int(r, a, __mn_hist, __mn_scratch)
    local int saved_r = 0
    saved_r += r
    if saved_r >= b then
        from q == 0 loop
            r -= b
            q += 1
        until r < b
    fi saved_r >= b
    push(saved_r, __mn_hist)
    delocal int saved_r = 0

// Divisione/resto signed C99 (truncamento verso zero, segno resto = segno
// dividendo). q = 0, r = 0 all'ingresso; a, b interi qualsiasi (b != 0
// richiesto). Reversibile: guard di segno (a<z / b<z) immutabili nel body.
procedure __mn_divmod_signed(int a, int b, int q, int r, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    local int abs_a = 0
    if a < z then
        abs_a -= a
    else
        abs_a += a
    fi a < z
    local int abs_b = 0
    if b < z then
        abs_b -= b
    else
        abs_b += b
    fi b < z
    local int qu = 0
    local int ru = 0
    call __mn_divmod_nonneg(abs_a, abs_b, qu, ru, __mn_hist, __mn_scratch)
    if a < z then
        if b < z then
            q += qu
        else
            q -= qu
        fi b < z
        r -= ru
    else
        if b < z then
            q -= qu
        else
            q += qu
        fi b < z
        r += ru
    fi a < z
    uncall __mn_divmod_nonneg(abs_a, abs_b, qu, ru, __mn_hist, __mn_scratch)
    delocal int ru = 0
    delocal int qu = 0
    if b < z then
        abs_b += b
    else
        abs_b -= b
    fi b < z
    delocal int abs_b = 0
    if a < z then
        abs_a += a
    else
        abs_a -= a
    fi a < z
    delocal int abs_a = 0
    delocal int z = 0

// Resto signed: estrae solo r da __mn_divmod_signed, scarta q via uncall
// dopo aver salvato r. Reversibilità preservata: uncall ripristina q=0,
// r=0, a/b inalterati.
procedure __mn_mod_signed(int a, int b, int r, stack __mn_hist, stack __mn_scratch)
    local int q = 0
    call __mn_divmod_signed(a, b, q, r, __mn_hist, __mn_scratch)
    local int r_save = 0
    r_save += r
    uncall __mn_divmod_signed(a, b, q, r, __mn_hist, __mn_scratch)
    r += r_save
    push(r_save, __mn_hist)
    delocal int r_save = 0
    delocal int q = 0

// Stampa intero con segno (show byte, char). Dipendenze: helpers.kairos, divmod.kairos.
// REVERSIBILE: usa `uncall __mn_divmod_nonneg` per ripristinare n e azzerare qu/rem.
// Permette `call __mn_putd_uint; uncall __mn_putd_uint` (show è no-op in inverse).

procedure __mn_putd_uint(int n, stack __mn_hist, stack __mn_scratch)
    local int ten = 0
    ten += 10
    local int qu = 0
    local int rem = 0
    if n >= ten then
        call __mn_divmod_nonneg(n, ten, qu, rem, __mn_hist, __mn_scratch)
        call __mn_putd_uint(qu, __mn_hist, __mn_scratch)
        local int ch = 0
        ch += rem
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= rem
        delocal int ch = 0
        uncall __mn_divmod_nonneg(n, ten, qu, rem, __mn_hist, __mn_scratch)
    else
        local int ch = 0
        ch += n
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= n
        delocal int ch = 0
    fi n >= ten
    ten -= 10
    delocal int rem = 0
    delocal int qu = 0
    delocal int ten = 0

procedure __mn_putd(int n, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if n < z then
        local int hy = 0
        hy += 45
        show(hy, char)
        hy -= 45
        delocal int hy = 0
        local int t = 0
        t -= n
        n += t
        n <=> t
        delocal int t = 0
        call __mn_putd_uint(n, __mn_hist, __mn_scratch)
        local int t2 = 0
        t2 -= n
        n += t2
        n <=> t2
        delocal int t2 = 0
    else
        call __mn_putd_uint(n, __mn_hist, __mn_scratch)
    fi n < z
    delocal int z = 0

// `%+d` runtime: prepend `+` se n>=0, poi __mn_putd.
procedure __mn_putd_plus(int n, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if n >= z then
        local int p = 0
        p += 43
        show(p, char)
        p -= 43
        delocal int p = 0
    fi n >= z
    delocal int z = 0
    call __mn_putd(n, __mn_hist, __mn_scratch)

// `% d` runtime: prepend ` ` se n>=0, poi __mn_putd.
procedure __mn_putd_space(int n, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if n >= z then
        local int sp = 0
        sp += 32
        show(sp, char)
        sp -= 32
        delocal int sp = 0
    fi n >= z
    delocal int z = 0
    call __mn_putd(n, __mn_hist, __mn_scratch)

// Conta le cifre decimali di un n >= 0 (inclusivo: n=0 conta 1).
// d += digits(n). Reversibile: n e ten immutati nel body.
procedure __mn_dcount_unsigned(int n, int d, stack __mn_hist, stack __mn_scratch)
    local int ten = 0
    ten += 10
    local int q = 0
    local int r = 0
    if n >= ten then
        call __mn_divmod_nonneg(n, ten, q, r, __mn_hist, __mn_scratch)
        call __mn_dcount_unsigned(q, d, __mn_hist, __mn_scratch)
        d += 1
        uncall __mn_divmod_nonneg(n, ten, q, r, __mn_hist, __mn_scratch)
    else
        d += 1
    fi n >= ten
    ten -= 10
    delocal int r = 0
    delocal int q = 0
    delocal int ten = 0

// Emette `count` spazi (codice 32). count immutato (loop counter su local rem).
procedure __mn_emit_spaces(int count, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if count > z then
        local int rem = 0
        rem += count
        from rem == count loop
            local int sp = 0
            sp += 32
            show(sp, char)
            sp -= 32
            delocal int sp = 0
            rem -= 1
        until rem == 0
        delocal int rem = 0
    fi count > z
    delocal int z = 0

// `%Nd` runtime: emette `(N - digits_of(n)) - (1 se n<0)` spazi a sinistra,
// poi `__mn_putd(n)`. N può essere <= digits → nessun padding.
procedure __mn_putd_width(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    local int sign_extra = 0
    if n < z then
        sign_extra += 1
    fi n < z
    local int abs_n = 0
    if n < z then
        abs_n -= n
    else
        abs_n += n
    fi n < z
    local int d = 0
    call __mn_dcount_unsigned(abs_n, d, __mn_hist, __mn_scratch)
    local int total = 0
    total += d
    total += sign_extra
    local int pad = 0
    pad += width
    pad -= total
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putd(n, __mn_hist, __mn_scratch)
    pad += total
    pad -= width
    delocal int pad = 0
    total -= sign_extra
    total -= d
    delocal int total = 0
    push(d, __mn_hist)
    delocal int d = 0
    if n < z then
        abs_n += n
    else
        abs_n -= n
    fi n < z
    delocal int abs_n = 0
    if n < z then
        sign_extra -= 1
    fi n < z
    delocal int sign_extra = 0
    delocal int z = 0

// Stampa intero non negativo in esadecimale minuscolo.
// Dipendenze: helpers.kairos, divmod.kairos.
// REVERSIBILE via `uncall __mn_divmod_nonneg` (vedi __mn_putd_uint).

procedure __mn_putx_uint(int n, stack __mn_hist, stack __mn_scratch)
    local int base = 0
    base += 16
    local int qu = 0
    local int rem = 0
    if n >= base then
        call __mn_divmod_nonneg(n, base, qu, rem, __mn_hist, __mn_scratch)
        call __mn_putx_uint(qu, __mn_hist, __mn_scratch)
        local int ch = 0
        local int ten = 0
        ten += 10
        if rem >= ten then
            ch += rem
            ch += 87
            show(ch, char)
            ch -= 87
            ch -= rem
        else
            ch += rem
            ch += 48
            show(ch, char)
            ch -= 48
            ch -= rem
        fi rem >= ten
        ten -= 10
        delocal int ten = 0
        delocal int ch = 0
        uncall __mn_divmod_nonneg(n, base, qu, rem, __mn_hist, __mn_scratch)
    else
        local int ch = 0
        local int ten = 0
        ten += 10
        if n >= ten then
            ch += n
            ch += 87
            show(ch, char)
            ch -= 87
            ch -= n
        else
            ch += n
            ch += 48
            show(ch, char)
            ch -= 48
            ch -= n
        fi n >= ten
        ten -= 10
        delocal int ten = 0
        delocal int ch = 0
    fi n >= base
    base -= 16
    delocal int rem = 0
    delocal int qu = 0
    delocal int base = 0

procedure __mn_putx(int n, stack __mn_hist, stack __mn_scratch)
    call __mn_putx_uint(n, __mn_hist, __mn_scratch)

// Stampa intero non negativo in ottale.
// Dipendenze: helpers.kairos, divmod.kairos.
// REVERSIBILE via `uncall __mn_divmod_nonneg` (vedi __mn_putd_uint).

procedure __mn_puto_uint(int n, stack __mn_hist, stack __mn_scratch)
    local int base = 0
    base += 8
    local int qu = 0
    local int rem = 0
    if n >= base then
        call __mn_divmod_nonneg(n, base, qu, rem, __mn_hist, __mn_scratch)
        call __mn_puto_uint(qu, __mn_hist, __mn_scratch)
        local int ch = 0
        ch += rem
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= rem
        delocal int ch = 0
        uncall __mn_divmod_nonneg(n, base, qu, rem, __mn_hist, __mn_scratch)
    else
        local int ch = 0
        ch += n
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= n
        delocal int ch = 0
    fi n >= base
    base -= 8
    delocal int rem = 0
    delocal int qu = 0
    delocal int base = 0

procedure __mn_puto(int n, stack __mn_hist, stack __mn_scratch)
    call __mn_puto_uint(n, __mn_hist, __mn_scratch)

// Pool puntatori Mnemo — generato, N=7 celle (__mn_mem0..__mn_mem6).
// `__mn_pool_free`: azzera cella; se slot è l’ultima alloc (LIFO), dec ctr.
// `__mn_pool_alloc`: non fare push(ctr) prima di ctr+=1 — la VM azzera ctr al push
// e il secondo malloc vedrebbe un contatore corrotto (handle duplicati / slot errati).

procedure __mn_pool_alloc(int ctr, int out_slot, stack __mn_hist, stack __mn_scratch)
    local int t = 0
        t += ctr
        push(out_slot, __mn_hist)
        out_slot += t
        ctr += 1
        push(t, __mn_hist)
    delocal int t = 0

procedure __mn_pool_store(int slot, int val, int __mn_mem0, int __mn_mem1, int __mn_mem2, int __mn_mem3, int __mn_mem4, int __mn_mem5, int __mn_mem6, stack __mn_hist, stack __mn_scratch)
    if slot == 0 then
        push(__mn_mem0, __mn_hist)
        __mn_mem0 += val
    fi slot == 0
    if slot == 1 then
        push(__mn_mem1, __mn_hist)
        __mn_mem1 += val
    fi slot == 1
    if slot == 2 then
        push(__mn_mem2, __mn_hist)
        __mn_mem2 += val
    fi slot == 2
    if slot == 3 then
        push(__mn_mem3, __mn_hist)
        __mn_mem3 += val
    fi slot == 3
    if slot == 4 then
        push(__mn_mem4, __mn_hist)
        __mn_mem4 += val
    fi slot == 4
    if slot == 5 then
        push(__mn_mem5, __mn_hist)
        __mn_mem5 += val
    fi slot == 5
    if slot == 6 then
        push(__mn_mem6, __mn_hist)
        __mn_mem6 += val
    fi slot == 6

procedure __mn_pool_load(int slot, int __mn_mem0, int __mn_mem1, int __mn_mem2, int __mn_mem3, int __mn_mem4, int __mn_mem5, int __mn_mem6, int out, stack __mn_hist, stack __mn_scratch)
    if slot == 0 then
        local int t = 0
            t += __mn_mem0
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 0
    if slot == 1 then
        local int t = 0
            t += __mn_mem1
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 1
    if slot == 2 then
        local int t = 0
            t += __mn_mem2
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 2
    if slot == 3 then
        local int t = 0
            t += __mn_mem3
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 3
    if slot == 4 then
        local int t = 0
            t += __mn_mem4
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 4
    if slot == 5 then
        local int t = 0
            t += __mn_mem5
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 5
    if slot == 6 then
        local int t = 0
            t += __mn_mem6
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 6

procedure __mn_pool_free(int slot, int __mn_mem0, int __mn_mem1, int __mn_mem2, int __mn_mem3, int __mn_mem4, int __mn_mem5, int __mn_mem6, int ctr, stack __mn_hist, stack __mn_scratch)
    local int ctr0 = 0
        ctr0 += ctr
        if slot == 0 then
            push(__mn_mem0, __mn_hist)
        fi slot == 0
        if slot == 1 then
            push(__mn_mem1, __mn_hist)
        fi slot == 1
        if slot == 2 then
            push(__mn_mem2, __mn_hist)
        fi slot == 2
        if slot == 3 then
            push(__mn_mem3, __mn_hist)
        fi slot == 3
        if slot == 4 then
            push(__mn_mem4, __mn_hist)
        fi slot == 4
        if slot == 5 then
            push(__mn_mem5, __mn_hist)
        fi slot == 5
        if slot == 6 then
            push(__mn_mem6, __mn_hist)
        fi slot == 6
        if slot == 0 then
            if ctr0 == 1 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 1
        fi slot == 0
        if slot == 1 then
            if ctr0 == 2 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 2
        fi slot == 1
        if slot == 2 then
            if ctr0 == 3 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 3
        fi slot == 2
        if slot == 3 then
            if ctr0 == 4 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 4
        fi slot == 3
        if slot == 4 then
            if ctr0 == 5 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 5
        fi slot == 4
        if slot == 5 then
            if ctr0 == 6 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 6
        fi slot == 5
        if slot == 6 then
            if ctr0 == 7 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 7
        fi slot == 6
        push(ctr0, __mn_hist)
    delocal int ctr0 = 0

procedure main()
    stack __mn_hist
    stack __mn_scratch
    local int __mn_mem0 = 0
    local int __mn_mem1 = 0
    local int __mn_mem2 = 0
    local int __mn_mem3 = 0
    local int __mn_mem4 = 0
    local int __mn_mem5 = 0
    local int __mn_mem6 = 0
    local int __mn_exit = 0
    local int __mn_pool_ctr = 0
    local int __mn_e0 = 0
    local int __mn_e1 = 0
    local int __mn_e2 = 0
    local int __mn_e3 = 0
        // generato da Mnemo da C
        __mn_pool_ctr += 3
        push(__mn_mem1, __mn_hist)
        __mn_mem1 += 2
        push(__mn_mem2, __mn_hist)
        __mn_mem2 += 0
        if __mn_mem1 == 1 then
            push(__mn_mem2, __mn_hist)
            __mn_mem2 += 10
        else
            if __mn_mem1 == 2 then
                push(__mn_mem2, __mn_hist)
                __mn_mem2 += 20
            else
                push(__mn_mem2, __mn_hist)
                __mn_mem2 += 30
            fi __mn_mem1 == 2
        fi __mn_mem1 == 1
        call __mn_putd(__mn_mem2, __mn_hist, __mn_scratch)
        __mn_e0 += 10
        show(__mn_e0, char)
        __mn_e0 -= 10
        push(__mn_e0, __mn_scratch)
        __mn_e1 += 10
        call __mn_divmod_signed(__mn_mem2, __mn_e1, __mn_e2, __mn_e3, __mn_hist, __mn_scratch)
        push(__mn_e3, __mn_scratch)
        push(__mn_e1, __mn_scratch)
        push(__mn_exit, __mn_hist)
        __mn_exit += __mn_e2
        push(__mn_e2, __mn_scratch)
        show(__mn_exit)
        // return
    push(__mn_e3, __mn_hist)
    delocal int __mn_e3 = 0
    push(__mn_e2, __mn_hist)
    delocal int __mn_e2 = 0
    push(__mn_e1, __mn_hist)
    delocal int __mn_e1 = 0
    push(__mn_e0, __mn_hist)
    delocal int __mn_e0 = 0
    push(__mn_pool_ctr, __mn_hist)
    delocal int __mn_pool_ctr = 0
    push(__mn_exit, __mn_hist)
    delocal int __mn_exit = 0
    push(__mn_mem6, __mn_hist)
    delocal int __mn_mem6 = 0
    push(__mn_mem5, __mn_hist)
    delocal int __mn_mem5 = 0
    push(__mn_mem4, __mn_hist)
    delocal int __mn_mem4 = 0
    push(__mn_mem3, __mn_hist)
    delocal int __mn_mem3 = 0
    push(__mn_mem2, __mn_hist)
    delocal int __mn_mem2 = 0
    push(__mn_mem1, __mn_hist)
    delocal int __mn_mem1 = 0
    push(__mn_mem0, __mn_hist)
    delocal int __mn_mem0 = 0
