// KAIROS_ALLOW_PAR_SHARED_INT
procedure fib_left(int __mn_mem0, int __mn_mem1, int __mn_mem2, int __mn_mem3, int __mn_mem4, int __mn_mem5, int __mn_mem6, int __mn_mem7, int __mn_mem8, int __mn_mem9, stack __mn_hist, stack __mn_scratch)
    local int __mn_e0 = 0
        // funzione C fib_left
        push(__mn_mem4, __mn_hist)
        __mn_mem4 += __mn_mem2
        push(__mn_mem5, __mn_hist)
        __mn_mem5 += 0
        call fibonacci(__mn_mem0, __mn_mem1, __mn_mem2, __mn_mem3, __mn_mem4, __mn_mem5, __mn_mem6, __mn_mem7, __mn_mem8, __mn_mem9, __mn_hist, __mn_scratch)
        push(__mn_e0, __mn_hist)
        __mn_e0 += __mn_mem5
        push(__mn_mem0, __mn_hist)
        __mn_mem0 += __mn_e0
        push(__mn_e0, __mn_scratch)
    push(__mn_e0, __mn_hist)
    delocal int __mn_e0 = 0
procedure fib_right(int __mn_mem0, int __mn_mem1, int __mn_mem2, int __mn_mem3, int __mn_mem4, int __mn_mem5, int __mn_mem6, int __mn_mem7, int __mn_mem8, int __mn_mem9, stack __mn_hist, stack __mn_scratch)
    local int __mn_e0 = 0
        // funzione C fib_right
        push(__mn_mem4, __mn_hist)
        __mn_mem4 += __mn_mem3
        push(__mn_mem5, __mn_hist)
        __mn_mem5 += 0
        call fibonacci(__mn_mem0, __mn_mem1, __mn_mem2, __mn_mem3, __mn_mem4, __mn_mem5, __mn_mem6, __mn_mem7, __mn_mem8, __mn_mem9, __mn_hist, __mn_scratch)
        push(__mn_e0, __mn_hist)
        __mn_e0 += __mn_mem5
        push(__mn_mem1, __mn_hist)
        __mn_mem1 += __mn_e0
        push(__mn_e0, __mn_scratch)
    push(__mn_e0, __mn_hist)
    delocal int __mn_e0 = 0
procedure fibonacci(int __mn_mem0, int __mn_mem1, int __mn_mem2, int __mn_mem3, int __mn_mem4, int __mn_mem5, int __mn_mem6, int __mn_mem7, int __mn_mem8, int __mn_mem9, stack __mn_hist, stack __mn_scratch)
    local int __mn_e0 = 0
    local int __mn_e1 = 0
    local int __mn_e2 = 0
    local int __mn_e3 = 0
    local int __mn_e4 = 0
    local int __mn_e5 = 0
        // funzione C fibonacci
        if __mn_mem4 <= 1 then
            push(__mn_mem5, __mn_hist)
            __mn_mem5 += 1
            // return
        else
            push(__mn_e0, __mn_hist)
            __mn_e0 += __mn_mem4
            __mn_e2 += __mn_mem4
            __mn_e2 -= 1
            push(__mn_mem4, __mn_hist)
            __mn_mem4 += __mn_e2
            push(__mn_e2, __mn_scratch)
            push(__mn_mem5, __mn_hist)
            __mn_mem5 += 0
            call fibonacci(__mn_mem0, __mn_mem1, __mn_mem2, __mn_mem3, __mn_mem4, __mn_mem5, __mn_mem6, __mn_mem7, __mn_mem8, __mn_mem9, __mn_hist, __mn_scratch)
            push(__mn_e1, __mn_hist)
            __mn_e1 += __mn_mem5
            push(__mn_mem4, __mn_hist)
            __mn_mem4 += __mn_e0
            __mn_e4 += __mn_mem4
            __mn_e4 -= 2
            push(__mn_mem4, __mn_hist)
            __mn_mem4 += __mn_e4
            push(__mn_e4, __mn_scratch)
            push(__mn_mem5, __mn_hist)
            __mn_mem5 += 0
            call fibonacci(__mn_mem0, __mn_mem1, __mn_mem2, __mn_mem3, __mn_mem4, __mn_mem5, __mn_mem6, __mn_mem7, __mn_mem8, __mn_mem9, __mn_hist, __mn_scratch)
            push(__mn_e3, __mn_hist)
            __mn_e3 += __mn_mem5
            __mn_e5 += __mn_e1
            __mn_e5 += __mn_e3
            push(__mn_mem5, __mn_hist)
            __mn_mem5 += __mn_e5
            push(__mn_e5, __mn_scratch)
            push(__mn_e0, __mn_scratch)
            push(__mn_e3, __mn_scratch)
            push(__mn_e1, __mn_scratch)
            // return
        fi __mn_mem4 <= 1
    push(__mn_e5, __mn_hist)
    delocal int __mn_e5 = 0
    push(__mn_e4, __mn_hist)
    delocal int __mn_e4 = 0
    push(__mn_e3, __mn_hist)
    delocal int __mn_e3 = 0
    push(__mn_e2, __mn_hist)
    delocal int __mn_e2 = 0
    push(__mn_e1, __mn_hist)
    delocal int __mn_e1 = 0
    push(__mn_e0, __mn_hist)
    delocal int __mn_e0 = 0
procedure main()
    stack __mn_pb0_hist
    stack __mn_pb0_scratch
