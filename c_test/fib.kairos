    local int __mn_mem19 = 0
    local int __mn_exit = 0
    local int __mn_e0 = 0
    local int __mn_e1 = 0
    local int __mn_e2 = 0
        // generato da Mnemo da C
        push(__mn_e0, __mn_hist)
        __mn_e0 += 9
        push(__mn_e1, __mn_hist)
        __mn_e1 += 8
        push(__mn_mem2, __mn_hist)
        __mn_mem2 += __mn_e0
        push(__mn_mem13, __mn_hist)
        __mn_mem13 += __mn_e1
        push(__mn_e1, __mn_scratch)
        push(__mn_e0, __mn_scratch)
        par
            call fib_left(__mn_mem0, __mn_mem1, __mn_mem2, __mn_mem3, __mn_mem4, __mn_mem5, __mn_mem6, __mn_mem7, __mn_mem8, __mn_mem9, __mn_pb0_hist, __mn_pb0_scratch)
        and
            call fib_right(__mn_mem0, __mn_mem11, __mn_mem12, __mn_mem13, __mn_mem14, __mn_mem15, __mn_mem16, __mn_mem17, __mn_mem18, __mn_mem19, __mn_pb1_hist, __mn_pb1_scratch)
        rap
        __mn_e2 += __mn_mem0
        __mn_e2 += __mn_mem11
        push(__mn_exit, __mn_hist)
        __mn_exit += __mn_e2
        push(__mn_e2, __mn_scratch)
        show(__mn_exit)
        // return
