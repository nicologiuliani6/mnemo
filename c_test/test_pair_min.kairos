// Minimal: due call bit_k_signed consecutive (come dentro and_into loop body)
procedure __mn_move_int(int dst, int src, stack __mn_hist, stack __mn_scratch)
    local stack __mn_g = nil
    push(src, __mn_g)
    pop(dst, __mn_g)
    delocal stack __mn_g = nil

procedure __mn_divmod_nonneg(int a, int b, int q, int r, stack __mn_hist, stack __mn_scratch)
    call __mn_move_int(r, a, __mn_hist, __mn_scratch)
    local int saved_r = 0
    saved_r += r
    if saved_r >= b then
        from q == 0 loop
            r -= b
            q += 1
        until r < b
    fi saved_r >= b
    push(saved_r, __mn_hist)
    delocal int saved_r = 0

procedure __mn_divmod_nonneg_div2(int a, int q, int r, stack __mn_hist, stack __mn_scratch)
    local int two = 0
    two += 1
    two += 1
    call __mn_divmod_nonneg(a, two, q, r, __mn_hist, __mn_scratch)
    delocal int two = 2

procedure __mn_floor_div2_signed(int t, int q, stack __mn_hist, stack __mn_scratch)
    local int r = 0
    local int ts = 0
    ts += t
    if ts >= 0 then
        call __mn_divmod_nonneg_div2(t, q, r, __mn_hist, __mn_scratch)
    else
        local int u = 0
        u -= t
        u += 1
        call __mn_divmod_nonneg_div2(u, q, r, __mn_hist, __mn_scratch)
        local int z = 0
        z -= q
        push(q, __mn_hist)
        call __mn_move_int(q, z, __mn_hist, __mn_scratch)
        local int sink = 0
        call __mn_move_int(sink, t, __mn_hist, __mn_scratch)
        push(sink, __mn_hist)
        delocal int sink = 0
        push(z, __mn_hist)
        delocal int z = 0
        push(u, __mn_hist)
        delocal int u = 0
    fi ts >= 0
    push(ts, __mn_hist)
    delocal int ts = 0
    push(r, __mn_hist)
    delocal int r = 0

procedure __mn_bit_k_signed(int a, int k, int bit_out, stack __mn_hist, stack __mn_scratch)
    local int t = 0
    t += a
    local int i = 0
    local int kp1 = 0
    kp1 += k
    kp1 += 1
    from i == 0 loop
        if i != 0 then
            local int q = 0
            call __mn_floor_div2_signed(t, q, __mn_hist, __mn_scratch)
            t += q
            push(q, __mn_hist)
            delocal int q = 0
        fi i != 0
        i += 1
    until i == kp1
    local int qf = 0
    local int rf = 0
    local int ts = 0
    ts += t
    if ts >= 0 then
        call __mn_divmod_nonneg_div2(t, qf, rf, __mn_hist, __mn_scratch)
        bit_out += rf
    else
        local int u = 0
        u -= t
        call __mn_divmod_nonneg_div2(u, qf, rf, __mn_hist, __mn_scratch)
        bit_out += rf
        push(u, __mn_hist)
        delocal int u = 0
    fi ts >= 0
    push(ts, __mn_hist)
    delocal int ts = 0
    push(rf, __mn_hist)
    delocal int rf = 0
    push(qf, __mn_hist)
    delocal int qf = 0
    push(kp1, __mn_hist)
    delocal int kp1 = 0
    push(i, __mn_hist)
    delocal int i = 0
    push(t, __mn_hist)
    delocal int t = 0

procedure wrapper(int a, int b, int k, int abit, int bbit, stack __mn_hist, stack __mn_scratch)
    call __mn_bit_k_signed(a, k, abit, __mn_hist, __mn_scratch)
    call __mn_bit_k_signed(b, k, bbit, __mn_hist, __mn_scratch)

procedure main()
    stack __mn_hist
    stack __mn_scratch
    local int a = 0
    local int b = 0
    local int k = 0
    local int abit = 0
    local int bbit = 0
        a += 42
        b += 255
        k += 1
        call wrapper(a, b, k, abit, bbit, __mn_hist, __mn_scratch)
        uncall wrapper(a, b, k, abit, bbit, __mn_hist, __mn_scratch)
    push(bbit, __mn_hist)
    delocal int bbit = 0
    push(abit, __mn_hist)
    delocal int abit = 0
    push(k, __mn_hist)
    delocal int k = 0
    push(b, __mn_hist)
    delocal int b = 0
    push(a, __mn_hist)
    delocal int a = 0
