        delocal int t = 0
    fi slot == 2
    if slot == 3 then
        local int t = 0
            t += __mn_mem3
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 3
    if slot == 4 then
        local int t = 0
            t += __mn_mem4
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 4
    if slot == 5 then
        local int t = 0
            t += __mn_mem5
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 5
    if slot == 6 then
        local int t = 0
            t += __mn_mem6
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 6
    if slot == 7 then
        local int t = 0
            t += __mn_mem7
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 7
    if slot == 8 then
        local int t = 0
            t += __mn_mem8
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 8
    if slot == 9 then
        local int t = 0
            t += __mn_mem9
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 9
    if slot == 10 then
        local int t = 0
            t += __mn_mem10
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 10

procedure __mn_pool_free(int slot, int __mn_mem0, int __mn_mem1, int __mn_mem2, int __mn_mem3, int __mn_mem4, int __mn_mem5, int __mn_mem6, int __mn_mem7, int __mn_mem8, int __mn_mem9, int __mn_mem10, int ctr)
    stack __mn_hist
    local int ctr0 = 0
        ctr0 += ctr
        if slot == 0 then
            push(__mn_mem0, __mn_hist)
        fi slot == 0
        if slot == 1 then
            push(__mn_mem1, __mn_hist)
        fi slot == 1
        if slot == 2 then
            push(__mn_mem2, __mn_hist)
        fi slot == 2
        if slot == 3 then
            push(__mn_mem3, __mn_hist)
        fi slot == 3
        if slot == 4 then
            push(__mn_mem4, __mn_hist)
        fi slot == 4
        if slot == 5 then
            push(__mn_mem5, __mn_hist)
        fi slot == 5
        if slot == 6 then
            push(__mn_mem6, __mn_hist)
        fi slot == 6
        if slot == 7 then
            push(__mn_mem7, __mn_hist)
        fi slot == 7
        if slot == 8 then
            push(__mn_mem8, __mn_hist)
        fi slot == 8
        if slot == 9 then
            push(__mn_mem9, __mn_hist)
        fi slot == 9
        if slot == 10 then
            push(__mn_mem10, __mn_hist)
        fi slot == 10
        if slot == 0 then
            if ctr0 == 1 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 1
        fi slot == 0
        if slot == 1 then
            if ctr0 == 2 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 2
        fi slot == 1
        if slot == 2 then
            if ctr0 == 3 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 3
        fi slot == 2
        if slot == 3 then
            if ctr0 == 4 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 4
        fi slot == 3
        if slot == 4 then
            if ctr0 == 5 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 5
        fi slot == 4
        if slot == 5 then
            if ctr0 == 6 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 6
        fi slot == 5
        if slot == 6 then
            if ctr0 == 7 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 7
        fi slot == 6
        if slot == 7 then
            if ctr0 == 8 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 8
        fi slot == 7
        if slot == 8 then
            if ctr0 == 9 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 9
        fi slot == 8
        if slot == 9 then
            if ctr0 == 10 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 10
        fi slot == 9
        if slot == 10 then
            if ctr0 == 11 then
                push(ctr, __mn_hist)
                ctr -= 1
            fi ctr0 == 11
        fi slot == 10
        push(ctr0, __mn_hist)
    delocal int ctr0 = 0

procedure server(int __mn_mem0, int __mn_mem1, int __mn_mem2, int __mn_mem3, int __mn_mem4, int __mn_mem5, int __mn_mem6, int __mn_mem7, int __mn_mem8, int __mn_mem9, int __mn_mem10, channel __mn_kch_req)
    stack __mn_hist
    stack __mn_scratch
    local channel __mn_kch_return_path = empty
    local int __mn_e0 = 0
        // funzione C server
        srecv(<__mn_mem0, __mn_kch_return_path>, __mn_kch_req)
        __mn_e0 += (__mn_mem0 + 1)
        push(__mn_mem0, __mn_hist)
        __mn_mem0 += __mn_e0
        push(__mn_e0, __mn_scratch)
        ssend(<__mn_mem0>, __mn_kch_return_path)
    push(__mn_e0, __mn_hist)
    delocal int __mn_e0 = 0
    delocal channel __mn_kch_return_path = empty
procedure client(int __mn_mem0, int __mn_mem1, int __mn_mem2, int __mn_mem3, int __mn_mem4, int __mn_mem5, int __mn_mem6, int __mn_mem7, int __mn_mem8, int __mn_mem9, int __mn_mem10, channel __mn_kch_req)
    stack __mn_hist
    stack __mn_scratch
    local channel __mn_kch_return_path = empty
    local int __mn_v_msg = 0
    local int __mn_pool_ctr = 0
    local int __mn_e0 = 0
    local int __mn_e1 = 0
    local int __mn_e2 = 0
        // funzione C client
        push(__mn_e1, __mn_hist)
        __mn_e1 += __mn_mem2
        call __mn_pool_load(__mn_e1, __mn_mem0, __mn_mem1, __mn_mem2, __mn_mem3, __mn_mem4, __mn_mem5, __mn_mem6, __mn_mem7, __mn_mem8, __mn_mem9, __mn_mem10, __mn_e0)
        push(__mn_v_msg, __mn_hist)
        __mn_v_msg += __mn_e0
        push(__mn_e0, __mn_scratch)
        push(__mn_e1, __mn_scratch)
        ssend(<__mn_v_msg, __mn_kch_return_path>, __mn_kch_req)
        srecv(<__mn_v_msg>, __mn_kch_return_path)
        push(__mn_e2, __mn_hist)
        __mn_e2 += __mn_mem2
        call __mn_pool_store(__mn_e2, __mn_v_msg, __mn_mem0, __mn_mem1, __mn_mem2, __mn_mem3, __mn_mem4, __mn_mem5, __mn_mem6, __mn_mem7, __mn_mem8, __mn_mem9, __mn_mem10)
        push(__mn_e2, __mn_scratch)
    push(__mn_e2, __mn_hist)
    delocal int __mn_e2 = 0
    push(__mn_e1, __mn_hist)
    delocal int __mn_e1 = 0
    push(__mn_e0, __mn_hist)
    delocal int __mn_e0 = 0
    push(__mn_pool_ctr, __mn_hist)
    delocal int __mn_pool_ctr = 0
    push(__mn_v_msg, __mn_hist)
    delocal int __mn_v_msg = 0
    delocal channel __mn_kch_return_path = empty
procedure main()
    stack __mn_hist
    local channel __mn_kch_req = empty
    local int __mn_mem0 = 0
    local int __mn_mem1 = 0
    local int __mn_mem2 = 0
    local int __mn_mem3 = 0
    local int __mn_mem4 = 0
    local int __mn_mem5 = 0
    local int __mn_mem6 = 0
    local int __mn_mem7 = 0
    local int __mn_mem8 = 0
    local int __mn_mem9 = 0
    local int __mn_mem10 = 0
    local int __mn_mem11 = 0
    local int __mn_mem12 = 0
    local int __mn_mem13 = 0
    local int __mn_mem14 = 0
    local int __mn_mem15 = 0
    local int __mn_mem16 = 0
    local int __mn_mem17 = 0
    local int __mn_mem18 = 0
    local int __mn_mem19 = 0
    local int __mn_mem20 = 0
    local int __mn_mem21 = 0
    local int __mn_exit = 0
    local int __mn_pool_ctr = 0
        // generato da Mnemo da C
        __mn_pool_ctr += 7
        push(__mn_mem6, __mn_hist)
        __mn_mem6 += 10
        // pre-PAR mirror `msg`: __mn_mem17 += __mn_mem6
        push(__mn_mem17, __mn_hist)
        __mn_mem17 += __mn_mem6
        push(__mn_mem13, __mn_hist)
        __mn_mem13 += 6
        par
            call server(__mn_mem0, __mn_mem1, __mn_mem2, __mn_mem3, __mn_mem4, __mn_mem5, __mn_mem6, __mn_mem7, __mn_mem8, __mn_mem9, __mn_mem10, __mn_kch_req)
        and
            call client(__mn_mem11, __mn_mem12, __mn_mem13, __mn_mem14, __mn_mem15, __mn_mem16, __mn_mem17, __mn_mem18, __mn_mem19, __mn_mem20, __mn_mem21, __mn_kch_req)
        rap
        push(__mn_exit, __mn_hist)
        __mn_exit += __mn_mem17
        show(__mn_exit)
        // return
    push(__mn_pool_ctr, __mn_hist)
    delocal int __mn_pool_ctr = 0
    push(__mn_exit, __mn_hist)
    delocal int __mn_exit = 0
    push(__mn_mem21, __mn_hist)
    delocal int __mn_mem21 = 0
    push(__mn_mem20, __mn_hist)
    delocal int __mn_mem20 = 0
