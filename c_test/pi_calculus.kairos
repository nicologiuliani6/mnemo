// Pool puntatori Mnemo — generato, N=11 celle (__mn_mem0..__mn_mem10).
// `__mn_pool_free`: azzera cella; se slot è l’ultima alloc (LIFO), dec ctr.

procedure __mn_pool_alloc(int ctr, int out_slot)
    stack __mn_hist
    local int t = 0
        t += ctr
        push(ctr, __mn_hist)
        ctr += 1
        push(out_slot, __mn_hist)
        out_slot += t
        push(t, __mn_hist)
    delocal int t = 0

procedure __mn_pool_store(int slot, int val, int __mn_mem0, int __mn_mem1, int __mn_mem2, int __mn_mem3, int __mn_mem4, int __mn_mem5, int __mn_mem6, int __mn_mem7, int __mn_mem8, int __mn_mem9, int __mn_mem10)
    stack __mn_hist
    if slot == 0 then
        push(__mn_mem0, __mn_hist)
        __mn_mem0 += val
    fi slot == 0
    if slot == 1 then
        push(__mn_mem1, __mn_hist)
        __mn_mem1 += val
    fi slot == 1
    if slot == 2 then
        push(__mn_mem2, __mn_hist)
        __mn_mem2 += val
    fi slot == 2
    if slot == 3 then
        push(__mn_mem3, __mn_hist)
        __mn_mem3 += val
    fi slot == 3
    if slot == 4 then
        push(__mn_mem4, __mn_hist)
        __mn_mem4 += val
    fi slot == 4
    if slot == 5 then
        push(__mn_mem5, __mn_hist)
        __mn_mem5 += val
    fi slot == 5
    if slot == 6 then
        push(__mn_mem6, __mn_hist)
        __mn_mem6 += val
    fi slot == 6
    if slot == 7 then
        push(__mn_mem7, __mn_hist)
        __mn_mem7 += val
    fi slot == 7
    if slot == 8 then
        push(__mn_mem8, __mn_hist)
        __mn_mem8 += val
    fi slot == 8
    if slot == 9 then
        push(__mn_mem9, __mn_hist)
        __mn_mem9 += val
    fi slot == 9
    if slot == 10 then
        push(__mn_mem10, __mn_hist)
        __mn_mem10 += val
    fi slot == 10

procedure __mn_pool_load(int slot, int __mn_mem0, int __mn_mem1, int __mn_mem2, int __mn_mem3, int __mn_mem4, int __mn_mem5, int __mn_mem6, int __mn_mem7, int __mn_mem8, int __mn_mem9, int __mn_mem10, int out)
    stack __mn_hist
    if slot == 0 then
        local int t = 0
            t += __mn_mem0
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot == 0
    if slot == 1 then
        local int t = 0
            t += __mn_mem1
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
