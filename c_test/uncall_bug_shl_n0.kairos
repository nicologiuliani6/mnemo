// __mn_shl_into inputs=[('x', 5), ('n', 0)]

procedure __mn_move_int(int dst, int src, stack __mn_hist, stack __mn_scratch)
    local stack __mn_g = nil
    push(src, __mn_g)
    pop(dst, __mn_g)
    delocal stack __mn_g = nil

// Prodotto: dst += a * b usando solo somme ripetute (Kairos non ha *).
// b deve essere >= 0; a e b non vengono distrutti. (b == 0 → nessuna iterazione.)
// `from i == 0` (non `< b`): FROM vero solo allo stato pre-loop (i=0),
// falso agli stati intermedi (i=1..b-1) — necessario per l'inversione Kairos.

procedure __mn_mul_into(int dst, int a, int b, stack __mn_hist, stack __mn_scratch)
    local int i = 0
    if b != 0 then
        from i == 0 loop
            i += 1
            dst += a
        until i == b
    fi b != 0
    delocal int i = b

// Divisione e resto: a, b interi con a >= 0 e b > 0; q = 0 e r = 0 all'ingresso.
// Uscita: q = a/b, r = a%b, a = 0. Il dividendo viene spostato in r via __mn_move_int (stack locale).
// `from q == 0`: FROM vero solo quando q=0 (pre-loop); falso a q=1,2,... (stati intermedi).
// `saved_r` copia a per il guard `if/fi`: la condizione non cambia durante il corpo.

procedure __mn_shl_into(int dst, int x, int n, stack __mn_hist, stack __mn_scratch)
    local int pow = 1
    local int i = 0
    if n != 0 then
        from i == 0 loop
            i += 1
            local int np = 0
            np += pow
            np += pow
            push(pow, __mn_hist)
            call __mn_move_int(pow, np, __mn_hist, __mn_scratch)
            push(np, __mn_hist)
            delocal int np = 0
        until i == n
    fi n != 0
    call __mn_mul_into(dst, x, pow, __mn_hist, __mn_scratch)
    push(i, __mn_hist)
    delocal int i = 0
    push(pow, __mn_hist)
    delocal int pow = 0

// dst += (x >> n) aritmetico
// `from i == 0` + guard: stesso pattern di shl_into.

procedure main()
    stack __mn_hist
    stack __mn_scratch
    local int x = 0
    local int n = 0
    local int dst = 0
    local int e_dst = 0
        x += 5
        n += 0
        call __mn_shl_into(dst, x, n, __mn_hist, __mn_scratch)
        e_dst ^= dst
        uncall __mn_shl_into(dst, x, n, __mn_hist, __mn_scratch)
        dst ^= e_dst
        e_dst ^= dst
        dst ^= e_dst
    push(e_dst, __mn_hist)
    delocal int e_dst = 0
    push(dst, __mn_hist)
    delocal int dst = 0
    push(n, __mn_hist)
    delocal int n = 0
    push(x, __mn_hist)
    delocal int x = 0
