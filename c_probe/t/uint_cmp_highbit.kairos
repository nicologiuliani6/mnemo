// Pool puntatori Mnemo — generato, N=5 celle (__mn_mem0..__mn_mem4).
// Header per-blocco (scritto dal lowering): mem{ctr}=nblk; ptr=ctr+1.
// Dispatch slot→cella via BINARY SEARCH (`if slot < mid`): O(log N) per
// accesso invece che O(N) lineare → deref a indice runtime molto più veloce.

procedure __mn_pool_alloc(int ctr, int out_slot, int nblk, stack __mn_hist, stack __mn_scratch)
    push(out_slot, __mn_hist)
    out_slot += ctr
    out_slot += 1
    ctr += nblk
    ctr += 1

procedure __mn_pool_free(int slot, int ctr, int nblk, stack __mn_hist, stack __mn_scratch)
    local int ctr0 = 0
        ctr0 += ctr
    local int last = 0
        last += slot
        last += nblk
        if ctr0 == last then
            ctr -= nblk
            ctr -= 1
        fi ctr0 == last
        push(last, __mn_hist)
    delocal int last = 0
        push(ctr0, __mn_hist)
    delocal int ctr0 = 0

procedure __mn_pool_store(int slot, int val, int __mn_mem0, int __mn_mem1, int __mn_mem2, int __mn_mem3, int __mn_mem4, stack __mn_hist, stack __mn_scratch)
    if slot < 2 then
        if slot < 1 then
            push(__mn_mem0, __mn_hist)
            __mn_mem0 += val
        else
            push(__mn_mem1, __mn_hist)
            __mn_mem1 += val
        fi slot < 1
    else
        if slot < 3 then
            push(__mn_mem2, __mn_hist)
            __mn_mem2 += val
        else
            if slot < 4 then
                push(__mn_mem3, __mn_hist)
                __mn_mem3 += val
            else
                push(__mn_mem4, __mn_hist)
                __mn_mem4 += val
            fi slot < 4
        fi slot < 3
    fi slot < 2

procedure __mn_pool_load(int slot, int __mn_mem0, int __mn_mem1, int __mn_mem2, int __mn_mem3, int __mn_mem4, int out, stack __mn_hist, stack __mn_scratch)
    if slot < 2 then
        if slot < 1 then
            local int t = 0
                t += __mn_mem0
                push(out, __mn_hist)
                out += t
                push(t, __mn_hist)
            delocal int t = 0
        else
            local int t = 0
                t += __mn_mem1
                push(out, __mn_hist)
                out += t
                push(t, __mn_hist)
            delocal int t = 0
        fi slot < 1
    else
        if slot < 3 then
            local int t = 0
                t += __mn_mem2
                push(out, __mn_hist)
                out += t
                push(t, __mn_hist)
            delocal int t = 0
        else
            if slot < 4 then
                local int t = 0
                    t += __mn_mem3
                    push(out, __mn_hist)
                    out += t
                    push(t, __mn_hist)
                delocal int t = 0
            else
                local int t = 0
                    t += __mn_mem4
                    push(out, __mn_hist)
                    out += t
                    push(t, __mn_hist)
                delocal int t = 0
            fi slot < 4
        fi slot < 3
    fi slot < 2

// Heap dinamico (vm->mn_pool): slot >= 5 (heap malloc, no alias nominato).
// Cresce on-demand → niente --ptr-pool-size per malloc-in-loop runtime.
procedure __mn_pool_store_dyn(int slot, int val, stack __mn_hist, stack __mn_scratch)
    if slot >= 5 then
        poolpush(slot, __mn_hist)
        pooladd(slot, val)
    fi slot >= 5

procedure __mn_pool_load_dyn(int slot, int out, stack __mn_hist, stack __mn_scratch)
    if slot >= 5 then
        local int t = 0
            poolget(slot, t)
            push(out, __mn_hist)
            out += t
            push(t, __mn_hist)
        delocal int t = 0
    fi slot >= 5

