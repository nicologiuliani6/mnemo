        ctr0 += ctr
    local int last = 0
        last += slot
        last += nblk
        if ctr0 == last then
            ctr -= nblk
            ctr -= 1
        fi ctr0 == last
        push(last, __mn_hist)
    delocal int last = 0
        push(ctr0, __mn_hist)
    delocal int ctr0 = 0

