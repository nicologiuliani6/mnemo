    sixteen += 16
    local int extra = 0
    extra += width
    extra -= sixteen
    local int zp = 0
    if extra > zp then
        call __mn_emit_zeros(extra, __mn_hist, __mn_scratch)
    fi extra > zp
    extra -= width
    extra += sixteen
    delocal int zp = 0
    delocal int extra = 0
    sixteen -= 16
    delocal int sixteen = 0
    local int eight = 0
    eight += 8
    call __mn_putX_width_zero(hi, eight, __mn_hist, __mn_scratch)
