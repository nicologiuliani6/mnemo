    sixteen += 16
    local int extra = 0
    extra += width
    extra -= sixteen
    local int zp = 0
    if extra > zp then
        call __mn_emit_zeros(extra, __mn_hist, __mn_scratch)
    fi extra > zp
    extra -= width
