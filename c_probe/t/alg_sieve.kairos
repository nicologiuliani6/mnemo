// Sposta il valore di src in dst (src azzerato) usando uno stack locale come "garbage" / condotto.
// La VM implementa `pop(dst, …)` come `*dst += valore`: per sostituire dst, azzeralo prima con
// `push(dst, hist)` sullo stack Janus del caller, poi `call __mn_move_int(dst, src)`.
procedure __mn_move_int(int dst, int src, stack __mn_hist, stack __mn_scratch)
    local stack __mn_g = nil
    push(src, __mn_g)
    pop(dst, __mn_g)
    delocal stack __mn_g = nil

// Mask x a 32 bit bassi: x = x & 0xFFFFFFFF. Reversibile via mnsplit32
// (forward: x=0, hi=high32, lo=low32) + restore low32 in x. I bit alti
// vengono salvati su __mn_hist (per la lap di inversione).
// Costo: O(1) — MNSPLIT32 è un opcode VM singolo.
procedure __mn_mask_u32(int x, stack __mn_hist, stack __mn_scratch)
    local int hi = 0
    local int lo = 0
    mnsplit32(x, hi, lo)
    x += lo
    push(lo, __mn_hist)
    delocal int lo = 0
    push(hi, __mn_hist)
    delocal int hi = 0

// Prodotto: dst += a * b usando solo somme ripetute (Kairos non ha *).
// b deve essere >= 0; a e b non vengono distrutti. (b == 0 → nessuna iterazione.)
// `from i == 0` (non `< b`): FROM vero solo allo stato pre-loop (i=0),
// falso agli stati intermedi (i=1..b-1) — necessario per l'inversione Kairos.
procedure __mn_mul_into(int dst, int a, int b, stack __mn_hist, stack __mn_scratch)
    local int i = 0
    if b != 0 then
        from i == 0 loop
            i += 1
            dst += a
        until i == b
    fi b != 0
    delocal int i = b

// Prodotto signed: dst += a * b dove b può essere negativo.
// Reversibile: guard `b < z` non si modifica nel body (b e z immutabili).
procedure __mn_mul_signed_into(int dst, int a, int b, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    local int abs_b = 0
    if b < z then
        abs_b -= b
    else
        abs_b += b
    fi b < z
    call __mn_mul_into(dst, a, abs_b, __mn_hist, __mn_scratch)
    if b < z then
        local int t = 0
        t -= dst
        dst += t
        dst <=> t
        delocal int t = 0
    fi b < z
    if b < z then
        abs_b += b
    else
        abs_b -= b
    fi b < z
    delocal int abs_b = 0
    delocal int z = 0

// Divisione e resto: a, b interi con a >= 0 e b > 0; q = 0 e r = 0 all'ingresso.
// Uscita: q = a/b, r = a%b, a = 0. Il dividendo viene spostato in r via __mn_move_int (stack locale).
// `from q == 0`: FROM vero solo quando q=0 (pre-loop); falso a q=1,2,... (stati intermedi).
// `saved_r` copia a per il guard `if/fi`: la condizione non cambia durante il corpo.
procedure __mn_divmod_nonneg(int a, int b, int q, int r, stack __mn_hist, stack __mn_scratch)
    call __mn_move_int(r, a, __mn_hist, __mn_scratch)
    local int saved_r = 0
    saved_r += r
    if saved_r >= b then
        from q == 0 loop
            r -= b
            q += 1
        until r < b
    fi saved_r >= b
    push(saved_r, __mn_hist)
    delocal int saved_r = 0

// Divisione/resto signed C99 (truncamento verso zero, segno resto = segno
// dividendo). q = 0, r = 0 all'ingresso; a, b interi qualsiasi (b != 0
// richiesto). Reversibile: guard di segno (a<z / b<z) immutabili nel body.
procedure __mn_divmod_signed(int a, int b, int q, int r, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    local int abs_a = 0
    if a < z then
        abs_a -= a
    else
        abs_a += a
    fi a < z
    local int abs_b = 0
    if b < z then
        abs_b -= b
    else
        abs_b += b
    fi b < z
    local int qu = 0
    local int ru = 0
    call __mn_divmod_nonneg(abs_a, abs_b, qu, ru, __mn_hist, __mn_scratch)
    if a < z then
        if b < z then
            q += qu
        else
            q -= qu
        fi b < z
        r -= ru
    else
        if b < z then
            q -= qu
        else
            q += qu
        fi b < z
        r += ru
    fi a < z
    uncall __mn_divmod_nonneg(abs_a, abs_b, qu, ru, __mn_hist, __mn_scratch)
    delocal int ru = 0
    delocal int qu = 0
    if b < z then
        abs_b += b
    else
        abs_b -= b
    fi b < z
    delocal int abs_b = 0
    if a < z then
        abs_a += a
    else
        abs_a -= a
    fi a < z
    delocal int abs_a = 0
    delocal int z = 0

// Divmod reversibile O(log a) shift-and-subtract via halving nativo VM
// (opcode MNHALVE = O(1) host C). Algoritmo:
//   Phase 1: dimezza a iterativamente, push bit LSB su __mn_scratch.
//            nbits = numero halvings (bits significativi di a).
//   Phase 2: pop bit MSB first; r' = 2*r + bit; if r' >= b: r' -= b; q += pow.
//            pow inizia a 2^(nbits-1), halved ad ogni iter.
// Input: a >= 0, b > 0, q = 0, r = 0. Output: q=a/b, r=a%b, a inalterato.
procedure __mn_divmod_nonneg_fast(int a, int b, int q, int r, stack __mn_hist, stack __mn_scratch)
    local int t = 0
    t += a
    local int nbits = 0
    local int pow = 0
    local int j = 0
    local int kp = 0
    local int nbits_minus = 0
    local int a_pos = 0
    if a > 0 then
        a_pos += 1
    fi a > 0
    if a_pos == 1 then
        // Phase 1: extract bits LSB-first to scratch.
        from nbits == 0 loop
            local int qh = 0
            local int ph = 0
            mnhalve(t, qh, ph)
            push(ph, __mn_scratch)
            t += qh
            push(ph, __mn_hist)
            delocal int ph = 0
            push(qh, __mn_hist)
            delocal int qh = 0
            nbits += 1
        until t == 0
        // Phase 2: pow = 2^(nbits-1) via doubling.
        pow += 1
        nbits_minus += nbits
        nbits_minus -= 1
        from kp == 0 loop
            local int np_d = 0
            np_d += pow
            np_d += pow
            push(pow, __mn_hist)
            pow += np_d
            push(np_d, __mn_hist)
            delocal int np_d = 0
            kp += 1
        until kp == nbits_minus
        // Phase 3: pop MSB-first, sub b, accumulate q, halve pow.
        from j == 0 loop
            local int bit = 0
            pop(bit, __mn_scratch)
            local int r_dbl = 0
            r_dbl += r
            r += r_dbl
            push(r_dbl, __mn_hist)
            delocal int r_dbl = 0
            r += bit
            local int doable = 0
            if r >= b then
                doable += 1
            fi r >= b
            if doable == 1 then
                r -= b
                q += pow
            fi doable == 1
            push(doable, __mn_hist)
            delocal int doable = 0
            push(bit, __mn_hist)
            delocal int bit = 0
            // Halve pow for next iter.
            local int qh2 = 0
            local int ph2 = 0
            mnhalve(pow, qh2, ph2)
            pow += qh2
            push(ph2, __mn_hist)
            delocal int ph2 = 0
            push(qh2, __mn_hist)
            delocal int qh2 = 0
            j += 1
        until j == nbits
    fi a_pos == 1
    push(a_pos, __mn_hist)
    delocal int a_pos = 0
    push(nbits_minus, __mn_hist)
    delocal int nbits_minus = 0
    push(kp, __mn_hist)
    delocal int kp = 0
    push(j, __mn_hist)
    delocal int j = 0
    push(pow, __mn_hist)
    delocal int pow = 0
    push(nbits, __mn_hist)
    delocal int nbits = 0
    push(t, __mn_hist)
    delocal int t = 0

// Resto signed: estrae solo r da __mn_divmod_signed, scarta q via uncall
// dopo aver salvato r. Reversibilità preservata: uncall ripristina q=0,
// r=0, a/b inalterati.
procedure __mn_mod_signed(int a, int b, int r, stack __mn_hist, stack __mn_scratch)
    local int q = 0
    call __mn_divmod_signed(a, b, q, r, __mn_hist, __mn_scratch)
    local int r_save = 0
    r_save += r
    uncall __mn_divmod_signed(a, b, q, r, __mn_hist, __mn_scratch)
    r += r_save
    push(r_save, __mn_hist)
    delocal int r_save = 0
    delocal int q = 0

// Stampa intero con segno (show byte, char). Dipendenze: helpers.kairos, divmod.kairos.
// REVERSIBILE: usa `uncall __mn_divmod_nonneg` per ripristinare n e azzerare qu/rem.
// Permette `call __mn_putd_uint; uncall __mn_putd_uint` (show è no-op in inverse).

procedure __mn_putd_uint(int n, stack __mn_hist, stack __mn_scratch)
    local int ten = 0
    ten += 10
    local int qu = 0
    local int rem = 0
    if n >= ten then
        call __mn_divmod_nonneg_fast(n, ten, qu, rem, __mn_hist, __mn_scratch)
        call __mn_putd_uint(qu, __mn_hist, __mn_scratch)
        local int ch = 0
        ch += rem
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= rem
        delocal int ch = 0
        uncall __mn_divmod_nonneg_fast(n, ten, qu, rem, __mn_hist, __mn_scratch)
    else
        local int ch = 0
        ch += n
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= n
        delocal int ch = 0
    fi n >= ten
    ten -= 10
    delocal int rem = 0
    delocal int qu = 0
    delocal int ten = 0

// Variante fast: usa __mn_divmod_nonneg_fast (sub-lineare via mnhalve VM)
// invece di __mn_divmod_nonneg (lineare O(n/10)). Necessario per n grandi
// (es. %u runtime negative dove n può essere fino a 2^32-1).
procedure __mn_putd_uint_fast(int n, stack __mn_hist, stack __mn_scratch)
    local int ten = 0
    ten += 10
    local int qu = 0
    local int rem = 0
    if n >= ten then
        call __mn_divmod_nonneg_fast(n, ten, qu, rem, __mn_hist, __mn_scratch)
        call __mn_putd_uint_fast(qu, __mn_hist, __mn_scratch)
        local int ch = 0
        ch += rem
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= rem
        delocal int ch = 0
        uncall __mn_divmod_nonneg_fast(n, ten, qu, rem, __mn_hist, __mn_scratch)
    else
        local int ch = 0
        ch += n
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= n
        delocal int ch = 0
    fi n >= ten
    ten -= 10
    delocal int rem = 0
    delocal int qu = 0
    delocal int ten = 0

procedure __mn_putd(int n, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if n < z then
        local int hy = 0
        hy += 45
        show(hy, char)
        hy -= 45
        delocal int hy = 0
        local int t = 0
        t -= n
        n += t
        n <=> t
        delocal int t = 0
        call __mn_putd_uint(n, __mn_hist, __mn_scratch)
        local int t2 = 0
        t2 -= n
        n += t2
        n <=> t2
        delocal int t2 = 0
    else
        call __mn_putd_uint(n, __mn_hist, __mn_scratch)
    fi n < z
    delocal int z = 0

// `%+d` runtime: prepend `+` se n>=0, poi __mn_putd.
procedure __mn_putd_plus(int n, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if n >= z then
        local int p = 0
        p += 43
        show(p, char)
        p -= 43
        delocal int p = 0
    fi n >= z
    delocal int z = 0
    call __mn_putd(n, __mn_hist, __mn_scratch)

// `% d` runtime: prepend ` ` se n>=0, poi __mn_putd.
procedure __mn_putd_space(int n, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if n >= z then
        local int sp = 0
        sp += 32
        show(sp, char)
        sp -= 32
        delocal int sp = 0
    fi n >= z
    delocal int z = 0
    call __mn_putd(n, __mn_hist, __mn_scratch)

// Conta le cifre decimali di un n >= 0 (inclusivo: n=0 conta 1).
// d += digits(n). Reversibile: n e ten immutati nel body.
procedure __mn_dcount_unsigned(int n, int d, stack __mn_hist, stack __mn_scratch)
    local int ten = 0
    ten += 10
    local int q = 0
    local int r = 0
    if n >= ten then
        call __mn_divmod_nonneg_fast(n, ten, q, r, __mn_hist, __mn_scratch)
        call __mn_dcount_unsigned(q, d, __mn_hist, __mn_scratch)
        d += 1
        uncall __mn_divmod_nonneg_fast(n, ten, q, r, __mn_hist, __mn_scratch)
    else
        d += 1
    fi n >= ten
    ten -= 10
    delocal int r = 0
    delocal int q = 0
    delocal int ten = 0

// Emette `count` spazi (codice 32). count immutato (loop counter su local rem).
procedure __mn_emit_spaces(int count, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if count > z then
        local int rem = 0
        rem += count
        from rem == count loop
            local int sp = 0
            sp += 32
            show(sp, char)
            sp -= 32
            delocal int sp = 0
            rem -= 1
        until rem == 0
        delocal int rem = 0
    fi count > z
    delocal int z = 0

// Emette `count` zeri ASCII (codice 48). count immutato.
procedure __mn_emit_zeros(int count, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if count > z then
        local int rem = 0
        rem += count
        from rem == count loop
            local int zc = 0
            zc += 48
            show(zc, char)
            zc -= 48
            delocal int zc = 0
            rem -= 1
        until rem == 0
        delocal int rem = 0
    fi count > z
    delocal int z = 0

// `%-Nd` runtime: emette `__mn_putd(n)` poi `(N - digits_of(n)) - (1 se n<0)`
// spazi a destra. Stesso schema di __mn_putd_width ma ordine show invertito.
procedure __mn_putd_width_left(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    local int sign_extra = 0
    if n < z then
        sign_extra += 1
    fi n < z
    local int abs_n = 0
    if n < z then
        abs_n -= n
    else
        abs_n += n
    fi n < z
    local int d = 0
    call __mn_dcount_unsigned(abs_n, d, __mn_hist, __mn_scratch)
    local int total = 0
    total += d
    total += sign_extra
    local int pad = 0
    pad += width
    pad -= total
    call __mn_putd(n, __mn_hist, __mn_scratch)
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    pad += total
    pad -= width
    delocal int pad = 0
    total -= sign_extra
    total -= d
    delocal int total = 0
    push(d, __mn_hist)
    delocal int d = 0
    if n < z then
        abs_n += n
    else
        abs_n -= n
    fi n < z
    delocal int abs_n = 0
    if n < z then
        sign_extra -= 1
    fi n < z
    delocal int sign_extra = 0
    delocal int z = 0

// `%0Nd` runtime: se n<0 emette `-`, poi `(N - 1 - digits)` zeri, poi
// __mn_putd_uint(abs_n). Se n>=0 emette `(N - digits)` zeri poi __mn_putd_uint(n).
procedure __mn_putd_width_zero(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    local int sign_extra = 0
    if n < z then
        sign_extra += 1
    fi n < z
    local int abs_n = 0
    if n < z then
        abs_n -= n
    else
        abs_n += n
    fi n < z
    local int d = 0
    call __mn_dcount_unsigned(abs_n, d, __mn_hist, __mn_scratch)
    local int total = 0
    total += d
    total += sign_extra
    local int pad = 0
    pad += width
    pad -= total
    if n < z then
        local int hy = 0
        hy += 45
        show(hy, char)
        hy -= 45
        delocal int hy = 0
    fi n < z
    local int zp = 0
    if pad > zp then
        call __mn_emit_zeros(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putd_uint(abs_n, __mn_hist, __mn_scratch)
    pad += total
    pad -= width
    delocal int pad = 0
    total -= sign_extra
    total -= d
    delocal int total = 0
    push(d, __mn_hist)
    delocal int d = 0
    if n < z then
        abs_n += n
    else
        abs_n -= n
    fi n < z
    delocal int abs_n = 0
    if n < z then
        sign_extra -= 1
    fi n < z
    delocal int sign_extra = 0
    delocal int z = 0

// `%Nu` runtime: emette (N - digits) spazi a sinistra, poi __mn_putd_uint(n).
procedure __mn_putd_uint_width(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_dcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putd_uint(n, __mn_hist, __mn_scratch)
    pad += d
    pad -= width
    delocal int pad = 0
    push(d, __mn_hist)
    delocal int d = 0

procedure __mn_putd_uint_width_left(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_dcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    call __mn_putd_uint(n, __mn_hist, __mn_scratch)
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    pad += d
    pad -= width
    delocal int pad = 0
    push(d, __mn_hist)
    delocal int d = 0

procedure __mn_putd_uint_width_zero(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_dcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    local int zp = 0
    if pad > zp then
        call __mn_emit_zeros(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putd_uint(n, __mn_hist, __mn_scratch)
    pad += d
    pad -= width
    delocal int pad = 0
    push(d, __mn_hist)
    delocal int d = 0

// `%Nd` runtime: emette `(N - digits_of(n)) - (1 se n<0)` spazi a sinistra,
// poi `__mn_putd(n)`. N può essere <= digits → nessun padding.
procedure __mn_putd_width(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    local int sign_extra = 0
    if n < z then
        sign_extra += 1
    fi n < z
    local int abs_n = 0
    if n < z then
        abs_n -= n
    else
        abs_n += n
    fi n < z
    local int d = 0
    call __mn_dcount_unsigned(abs_n, d, __mn_hist, __mn_scratch)
    local int total = 0
    total += d
    total += sign_extra
    local int pad = 0
    pad += width
    pad -= total
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putd(n, __mn_hist, __mn_scratch)
    pad += total
    pad -= width
    delocal int pad = 0
    total -= sign_extra
    total -= d
    delocal int total = 0
    push(d, __mn_hist)
    delocal int d = 0
    if n < z then
        abs_n += n
    else
        abs_n -= n
    fi n < z
    delocal int abs_n = 0
    if n < z then
        sign_extra -= 1
    fi n < z
    delocal int sign_extra = 0
    delocal int z = 0

// Stampa intero non negativo in esadecimale minuscolo.
// Dipendenze: helpers.kairos, divmod.kairos.
// REVERSIBILE via `uncall __mn_divmod_nonneg` (vedi __mn_putd_uint).

procedure __mn_putx_uint(int n, stack __mn_hist, stack __mn_scratch)
    local int base = 0
    base += 16
    local int qu = 0
    local int rem = 0
    if n >= base then
        call __mn_divmod_nonneg_fast(n, base, qu, rem, __mn_hist, __mn_scratch)
        call __mn_putx_uint(qu, __mn_hist, __mn_scratch)
        local int ch = 0
        local int ten = 0
        ten += 10
        if rem >= ten then
            ch += rem
            ch += 87
            show(ch, char)
            ch -= 87
            ch -= rem
        else
            ch += rem
            ch += 48
            show(ch, char)
            ch -= 48
            ch -= rem
        fi rem >= ten
        ten -= 10
        delocal int ten = 0
        delocal int ch = 0
        uncall __mn_divmod_nonneg_fast(n, base, qu, rem, __mn_hist, __mn_scratch)
    else
        local int ch = 0
        local int ten = 0
        ten += 10
        if n >= ten then
            ch += n
            ch += 87
            show(ch, char)
            ch -= 87
            ch -= n
        else
            ch += n
            ch += 48
            show(ch, char)
            ch -= 48
            ch -= n
        fi n >= ten
        ten -= 10
        delocal int ten = 0
        delocal int ch = 0
    fi n >= base
    base -= 16
    delocal int rem = 0
    delocal int qu = 0
    delocal int base = 0

procedure __mn_putx(int n, stack __mn_hist, stack __mn_scratch)
    call __mn_putx_uint(n, __mn_hist, __mn_scratch)

// Conta le cifre esadecimali di un n >= 0 (n=0 conta 1).
// d += hex_digits(n). Reversibile via uncall divmod_nonneg.
procedure __mn_hcount_unsigned(int n, int d, stack __mn_hist, stack __mn_scratch)
    local int base = 0
    base += 16
    local int q = 0
    local int r = 0
    if n >= base then
        call __mn_divmod_nonneg_fast(n, base, q, r, __mn_hist, __mn_scratch)
        call __mn_hcount_unsigned(q, d, __mn_hist, __mn_scratch)
        d += 1
        uncall __mn_divmod_nonneg_fast(n, base, q, r, __mn_hist, __mn_scratch)
    else
        d += 1
    fi n >= base
    base -= 16
    delocal int r = 0
    delocal int q = 0
    delocal int base = 0

// `%Nx` runtime: emette (N - hex_digits(n)) spazi a sinistra, poi __mn_putx.
procedure __mn_putx_width(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_hcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
