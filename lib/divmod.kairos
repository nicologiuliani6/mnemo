// Divisione e resto: a, b interi con a >= 0 e b > 0; q = 0 e r = 0 all'ingresso.
// Uscita: q = a/b, r = a%b, a = 0. Il dividendo viene spostato in r via __mn_move_int (stack locale).
// `from q == 0`: FROM vero solo quando q=0 (pre-loop); falso a q=1,2,... (stati intermedi).
// `saved_r` copia a per il guard `if/fi`: la condizione non cambia durante il corpo.
procedure __mn_divmod_nonneg(int a, int b, int q, int r, stack __mn_hist, stack __mn_scratch)
    call __mn_move_int(r, a, __mn_hist, __mn_scratch)
    local int saved_r = 0
    saved_r += r
    if saved_r >= b then
        from q == 0 loop
            r -= b
            q += 1
        until r < b
    fi saved_r >= b
    push(saved_r, __mn_hist)
    delocal int saved_r = 0

// Divisione/resto signed C99 (truncamento verso zero, segno resto = segno
// dividendo). q = 0, r = 0 all'ingresso; a, b interi qualsiasi (b != 0
// richiesto). Reversibile: guard di segno (a<z / b<z) immutabili nel body.
procedure __mn_divmod_signed(int a, int b, int q, int r, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    local int abs_a = 0
    if a < z then
        abs_a -= a
    else
        abs_a += a
    fi a < z
    local int abs_b = 0
    if b < z then
        abs_b -= b
    else
        abs_b += b
    fi b < z
    local int qu = 0
    local int ru = 0
    call __mn_divmod_nonneg(abs_a, abs_b, qu, ru, __mn_hist, __mn_scratch)
    if a < z then
        if b < z then
            q += qu
        else
            q -= qu
        fi b < z
        r -= ru
    else
        if b < z then
            q -= qu
        else
            q += qu
        fi b < z
        r += ru
    fi a < z
    uncall __mn_divmod_nonneg(abs_a, abs_b, qu, ru, __mn_hist, __mn_scratch)
    delocal int ru = 0
    delocal int qu = 0
    if b < z then
        abs_b += b
    else
        abs_b -= b
    fi b < z
    delocal int abs_b = 0
    if a < z then
        abs_a += a
    else
        abs_a -= a
    fi a < z
    delocal int abs_a = 0
    delocal int z = 0

// Divmod reversibile O(63) passi FISSI, 100% Kairos puro (nessun opcode
// nativo). Sostituisce la vecchia versione basata su MNHALVE nativo — stessa
// interfaccia. Fase 1 costruisce 63 pesi 1,2,4,...,2^62 via variabili
// FRESCHE (w0..w62, mai self-referenziali: `x += x` è un errore statico in
// Kairos) — NESSUNA `call` nel loop di raddoppio (a differenza di and_into/
// or_into che usano `call __mn_move_int` per il proprio raddoppio: qui va
// evitato perché __mn_divmod_nonneg_fast è a sua volta nel path caldo di
// and_into/or_into via __mn_divmod_nonneg_div2 → __mn_bit_k_signed, chiamato
// O(k^2) volte; l'overhead di call/return per ogni raddoppio moltiplicato per
// le tante invocazioni rendeva and/or impraticabilmente lenti). 63 pesi
// coprono qualunque nonneg int64 (2^62 = bit più alto per un nonneg a 63 bit).
// Fase 2 ripopa MSB-first (stack LIFO: pushati crescenti, escono
// decrescenti), decodifica il bit di t confrontando t>=w, e fa la divisione
// binaria a scorrimento contro b: r=2r+bit; se r>=b, r-=b e q+=w (stesso peso
// serve sia per il bit di a sia per il bit di q — bit i di a e bit i di q
// condividono 2^i nella divisione binaria standard).
// Input: a >= 0, b > 0, q = 0, r = 0. Output: q=a/b, r=a%b, a inalterato.
procedure __mn_divmod_nonneg_fast(int a, int b, int q, int r, stack __mn_hist, stack __mn_scratch)
    local int t = 0
    t += a
    local int w0 = 1
    local int w1 = 0
    w1 += w0
    w1 += w0
    local int w2 = 0
    w2 += w1
    w2 += w1
