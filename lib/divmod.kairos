    push(w53, __mn_scratch)
    push(w54, __mn_scratch)
    push(w55, __mn_scratch)
    push(w56, __mn_scratch)
    push(w57, __mn_scratch)
    push(w58, __mn_scratch)
    push(w59, __mn_scratch)
    push(w60, __mn_scratch)
    push(w61, __mn_scratch)
    push(w62, __mn_scratch)
    local int j = 0
    from j == 0 loop
        local int w = 0
        pop(w, __mn_scratch)
        local int fits = 0
        if t >= w then
            fits += 1
        fi t >= w
        local int bit = 0
        if fits == 1 then
            bit += 1
            t -= w
        fi fits == 1
        local int r_dbl = 0
        r_dbl += r
        r += r_dbl
        push(r_dbl, __mn_hist)
        delocal int r_dbl = 0
        r += bit
        local int doable = 0
        if r >= b then
            doable += 1
        fi r >= b
        if doable == 1 then
            r -= b
            q += w
        fi doable == 1
        push(doable, __mn_hist)
        delocal int doable = 0
        push(bit, __mn_hist)
        delocal int bit = 0
        push(fits, __mn_hist)
        delocal int fits = 0
        push(w, __mn_hist)
        delocal int w = 0
        j += 1
    until j == 63
    push(j, __mn_hist)
    delocal int j = 0
    delocal int w62 = 0
    delocal int w61 = 0
