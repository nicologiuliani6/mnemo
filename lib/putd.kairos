// Stampa intero con segno (show byte, char). Dipendenze: helpers.kairos, divmod.kairos.
// REVERSIBILE: usa `uncall __mn_divmod_nonneg` per ripristinare n e azzerare qu/rem.
// Permette `call __mn_putd_uint; uncall __mn_putd_uint` (show è no-op in inverse).

procedure __mn_putd_uint(int n, stack __mn_hist, stack __mn_scratch)
    local int ten = 0
    ten += 10
    local int qu = 0
    local int rem = 0
    if n >= ten then
        call __mn_divmod_nonneg_fast(n, ten, qu, rem, __mn_hist, __mn_scratch)
        call __mn_putd_uint(qu, __mn_hist, __mn_scratch)
        local int ch = 0
        ch += rem
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= rem
        delocal int ch = 0
        uncall __mn_divmod_nonneg_fast(n, ten, qu, rem, __mn_hist, __mn_scratch)
    else
        local int ch = 0
        ch += n
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= n
        delocal int ch = 0
    fi n >= ten
    ten -= 10
    delocal int rem = 0
    delocal int qu = 0
    delocal int ten = 0

// Variante fast: usa __mn_divmod_nonneg_fast (sub-lineare via mnhalve VM)
// invece di __mn_divmod_nonneg (lineare O(n/10)). Necessario per n grandi
// (es. %u runtime negative dove n può essere fino a 2^32-1).
procedure __mn_putd_uint_fast(int n, stack __mn_hist, stack __mn_scratch)
    local int ten = 0
    ten += 10
    local int qu = 0
    local int rem = 0
    if n >= ten then
        call __mn_divmod_nonneg_fast(n, ten, qu, rem, __mn_hist, __mn_scratch)
        call __mn_putd_uint_fast(qu, __mn_hist, __mn_scratch)
        local int ch = 0
        ch += rem
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= rem
        delocal int ch = 0
        uncall __mn_divmod_nonneg_fast(n, ten, qu, rem, __mn_hist, __mn_scratch)
    else
        local int ch = 0
        ch += n
        ch += 48
        show(ch, char)
        ch -= 48
        ch -= n
        delocal int ch = 0
    fi n >= ten
    ten -= 10
    delocal int rem = 0
    delocal int qu = 0
    delocal int ten = 0

procedure __mn_putd(int n, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if n < z then
        local int hy = 0
        hy += 45
        show(hy, char)
        hy -= 45
        delocal int hy = 0
        local int t = 0
        t -= n
        n += t
        n <=> t
        delocal int t = 0
        call __mn_putd_uint(n, __mn_hist, __mn_scratch)
        local int t2 = 0
        t2 -= n
        n += t2
        n <=> t2
        delocal int t2 = 0
    else
        call __mn_putd_uint(n, __mn_hist, __mn_scratch)
    fi n < z
    delocal int z = 0

// `%+d` runtime: prepend `+` se n>=0, poi __mn_putd.
procedure __mn_putd_plus(int n, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if n >= z then
        local int p = 0
        p += 43
        show(p, char)
        p -= 43
        delocal int p = 0
    fi n >= z
    delocal int z = 0
    call __mn_putd(n, __mn_hist, __mn_scratch)

// `% d` runtime: prepend ` ` se n>=0, poi __mn_putd.
procedure __mn_putd_space(int n, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if n >= z then
        local int sp = 0
        sp += 32
        show(sp, char)
        sp -= 32
        delocal int sp = 0
    fi n >= z
    delocal int z = 0
    call __mn_putd(n, __mn_hist, __mn_scratch)

// Conta le cifre decimali di un n >= 0 (inclusivo: n=0 conta 1).
// d += digits(n). Reversibile: n e ten immutati nel body.
procedure __mn_dcount_unsigned(int n, int d, stack __mn_hist, stack __mn_scratch)
    local int ten = 0
    ten += 10
    local int q = 0
    local int r = 0
    if n >= ten then
        call __mn_divmod_nonneg_fast(n, ten, q, r, __mn_hist, __mn_scratch)
        call __mn_dcount_unsigned(q, d, __mn_hist, __mn_scratch)
        d += 1
        uncall __mn_divmod_nonneg_fast(n, ten, q, r, __mn_hist, __mn_scratch)
    else
        d += 1
    fi n >= ten
    ten -= 10
    delocal int r = 0
    delocal int q = 0
    delocal int ten = 0

// Emette `count` spazi (codice 32). count immutato (loop counter su local rem).
procedure __mn_emit_spaces(int count, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if count > z then
        local int rem = 0
        rem += count
        from rem == count do
            local int sp = 0
            sp += 32
            show(sp, char)
            sp -= 32
            delocal int sp = 0
            rem -= 1
        loop until rem == 0
        delocal int rem = 0
    fi count > z
    delocal int z = 0

// Emette `count` zeri ASCII (codice 48). count immutato.
procedure __mn_emit_zeros(int count, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    if count > z then
        local int rem = 0
        rem += count
        from rem == count do
            local int zc = 0
            zc += 48
            show(zc, char)
            zc -= 48
            delocal int zc = 0
            rem -= 1
        loop until rem == 0
        delocal int rem = 0
    fi count > z
    delocal int z = 0

// `%-Nd` runtime: emette `__mn_putd(n)` poi `(N - digits_of(n)) - (1 se n<0)`
// spazi a destra. Stesso schema di __mn_putd_width ma ordine show invertito.
procedure __mn_putd_width_left(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    local int sign_extra = 0
    if n < z then
        sign_extra += 1
    fi n < z
    local int abs_n = 0
    if n < z then
        abs_n -= n
    else
        abs_n += n
    fi n < z
    local int d = 0
    call __mn_dcount_unsigned(abs_n, d, __mn_hist, __mn_scratch)
    local int total = 0
    total += d
    total += sign_extra
    local int pad = 0
    pad += width
    pad -= total
    call __mn_putd(n, __mn_hist, __mn_scratch)
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    pad += total
    pad -= width
    delocal int pad = 0
    total -= sign_extra
    total -= d
    delocal int total = 0
    push(d, __mn_hist)
    delocal int d = 0
    if n < z then
        abs_n += n
    else
        abs_n -= n
    fi n < z
    delocal int abs_n = 0
    if n < z then
        sign_extra -= 1
    fi n < z
    delocal int sign_extra = 0
    delocal int z = 0

// `%0Nd` runtime: se n<0 emette `-`, poi `(N - 1 - digits)` zeri, poi
// __mn_putd_uint(abs_n). Se n>=0 emette `(N - digits)` zeri poi __mn_putd_uint(n).
procedure __mn_putd_width_zero(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    local int sign_extra = 0
    if n < z then
        sign_extra += 1
    fi n < z
    local int abs_n = 0
    if n < z then
        abs_n -= n
    else
        abs_n += n
    fi n < z
    local int d = 0
    call __mn_dcount_unsigned(abs_n, d, __mn_hist, __mn_scratch)
    local int total = 0
    total += d
    total += sign_extra
    local int pad = 0
    pad += width
    pad -= total
    if n < z then
        local int hy = 0
        hy += 45
        show(hy, char)
        hy -= 45
        delocal int hy = 0
    fi n < z
    local int zp = 0
    if pad > zp then
        call __mn_emit_zeros(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putd_uint(abs_n, __mn_hist, __mn_scratch)
    pad += total
    pad -= width
    delocal int pad = 0
    total -= sign_extra
    total -= d
    delocal int total = 0
    push(d, __mn_hist)
    delocal int d = 0
    if n < z then
        abs_n += n
    else
        abs_n -= n
    fi n < z
    delocal int abs_n = 0
    if n < z then
        sign_extra -= 1
    fi n < z
    delocal int sign_extra = 0
    delocal int z = 0

// `%Nu` runtime: emette (N - digits) spazi a sinistra, poi __mn_putd_uint(n).
procedure __mn_putd_uint_width(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_dcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putd_uint(n, __mn_hist, __mn_scratch)
    pad += d
    pad -= width
    delocal int pad = 0
    push(d, __mn_hist)
    delocal int d = 0

procedure __mn_putd_uint_width_left(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_dcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    call __mn_putd_uint(n, __mn_hist, __mn_scratch)
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    pad += d
    pad -= width
    delocal int pad = 0
    push(d, __mn_hist)
    delocal int d = 0

procedure __mn_putd_uint_width_zero(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int d = 0
    call __mn_dcount_unsigned(n, d, __mn_hist, __mn_scratch)
    local int pad = 0
    pad += width
    pad -= d
    local int zp = 0
    if pad > zp then
        call __mn_emit_zeros(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putd_uint(n, __mn_hist, __mn_scratch)
    pad += d
    pad -= width
    delocal int pad = 0
    push(d, __mn_hist)
    delocal int d = 0

// `%Nd` runtime: emette `(N - digits_of(n)) - (1 se n<0)` spazi a sinistra,
// poi `__mn_putd(n)`. N può essere <= digits → nessun padding.
procedure __mn_putd_width(int n, int width, stack __mn_hist, stack __mn_scratch)
    local int z = 0
    local int sign_extra = 0
    if n < z then
        sign_extra += 1
    fi n < z
    local int abs_n = 0
    if n < z then
        abs_n -= n
    else
        abs_n += n
    fi n < z
    local int d = 0
    call __mn_dcount_unsigned(abs_n, d, __mn_hist, __mn_scratch)
    local int total = 0
    total += d
    total += sign_extra
    local int pad = 0
    pad += width
    pad -= total
    local int zp = 0
    if pad > zp then
        call __mn_emit_spaces(pad, __mn_hist, __mn_scratch)
    fi pad > zp
    delocal int zp = 0
    call __mn_putd(n, __mn_hist, __mn_scratch)
    pad += total
    pad -= width
    delocal int pad = 0
    total -= sign_extra
    total -= d
    delocal int total = 0
    push(d, __mn_hist)
    delocal int d = 0
    if n < z then
        abs_n += n
    else
        abs_n -= n
    fi n < z
    delocal int abs_n = 0
    if n < z then
        sign_extra -= 1
    fi n < z
    delocal int sign_extra = 0
    delocal int z = 0
