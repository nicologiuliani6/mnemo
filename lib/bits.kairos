// Operazioni bitwise via aritmetica (Kairos non ha &, |, <<, >>).
// Richiede helpers.kairos, mul.kairos, divmod.kairos.
// Convenzione: gli *_into fanno dst += f(...) assumendo dst partenza dal caller.

// Chiamate con divisore 2: le `call` Kairos accettano solo identificatori, non `2` letterale.
// O(32) passi FISSI, 100% puro — VERSIONE SNELLA dedicata (non passa per
// __mn_divmod_nonneg_fast): questo è il path caldissimo di and_into/or_into
// (__mn_bit_k_signed lo chiama O(k) volte per bit, O(k^2) volte totali per
// and/or su 31 bit) — niente `call` extra, opera direttamente su `a` (che
// deve comunque azzerarsi in uscita, come il contratto nativo mnhalve
// originale, quindi non serve nessuna copia/sink separata).
procedure __mn_divmod_nonneg_div2(int a, int q, int r, stack __mn_hist, stack __mn_scratch)
    local int w0 = 1
    local int w1 = 0
    w1 += w0
    w1 += w0
    local int w2 = 0
    w2 += w1
    w2 += w1
    local int w3 = 0
    w3 += w2
    w3 += w2
    local int w4 = 0
    w4 += w3
    w4 += w3
    local int w5 = 0
    w5 += w4
    w5 += w4
    local int w6 = 0
    w6 += w5
    w6 += w5
    local int w7 = 0
    w7 += w6
    w7 += w6
    local int w8 = 0
    w8 += w7
    w8 += w7
    local int w9 = 0
    w9 += w8
    w9 += w8
    local int w10 = 0
    w10 += w9
    w10 += w9
    local int w11 = 0
    w11 += w10
    w11 += w10
    local int w12 = 0
    w12 += w11
    w12 += w11
    local int w13 = 0
    w13 += w12
    w13 += w12
    local int w14 = 0
    w14 += w13
    w14 += w13
    local int w15 = 0
    w15 += w14
    w15 += w14
    local int w16 = 0
    w16 += w15
    w16 += w15
    local int w17 = 0
    w17 += w16
    w17 += w16
    local int w18 = 0
    w18 += w17
    w18 += w17
    local int w19 = 0
    w19 += w18
    w19 += w18
    local int w20 = 0
    w20 += w19
    w20 += w19
    local int w21 = 0
    w21 += w20
    w21 += w20
    local int w22 = 0
    w22 += w21
    w22 += w21
    local int w23 = 0
    w23 += w22
    w23 += w22
    local int w24 = 0
    w24 += w23
    w24 += w23
    local int w25 = 0
    w25 += w24
    w25 += w24
    local int w26 = 0
    w26 += w25
    w26 += w25
    local int w27 = 0
    w27 += w26
    w27 += w26
    local int w28 = 0
    w28 += w27
    w28 += w27
    local int w29 = 0
    w29 += w28
    w29 += w28
    local int w30 = 0
    w30 += w29
    w30 += w29
    local int w31 = 0
    w31 += w30
    w31 += w30
    push(w0, __mn_scratch)
    push(w1, __mn_scratch)
    push(w2, __mn_scratch)
    push(w3, __mn_scratch)
    push(w4, __mn_scratch)
    push(w5, __mn_scratch)
    push(w6, __mn_scratch)
    push(w7, __mn_scratch)
    push(w8, __mn_scratch)
    push(w9, __mn_scratch)
    push(w10, __mn_scratch)
    push(w11, __mn_scratch)
    push(w12, __mn_scratch)
    push(w13, __mn_scratch)
    push(w14, __mn_scratch)
    push(w15, __mn_scratch)
    push(w16, __mn_scratch)
    push(w17, __mn_scratch)
    push(w18, __mn_scratch)
    push(w19, __mn_scratch)
    push(w20, __mn_scratch)
    push(w21, __mn_scratch)
    push(w22, __mn_scratch)
    push(w23, __mn_scratch)
    push(w24, __mn_scratch)
    push(w25, __mn_scratch)
    push(w26, __mn_scratch)
    push(w27, __mn_scratch)
    push(w28, __mn_scratch)
    push(w29, __mn_scratch)
    push(w30, __mn_scratch)
    push(w31, __mn_scratch)
    local int j = 0
    from j == 0 loop
        local int w = 0
        pop(w, __mn_scratch)
        local int fits = 0
        if a >= w then
            fits += 1
        fi a >= w
        local int bit = 0
        if fits == 1 then
            bit += 1
            a -= w
        fi fits == 1
        local int r_dbl = 0
        r_dbl += r
        r += r_dbl
        push(r_dbl, __mn_hist)
        delocal int r_dbl = 0
        r += bit
        local int doable = 0
        if r >= 2 then
            doable += 1
        fi r >= 2
        if doable == 1 then
            r -= 2
            q += w
        fi doable == 1
        push(doable, __mn_hist)
        delocal int doable = 0
        push(bit, __mn_hist)
        delocal int bit = 0
        push(fits, __mn_hist)
        delocal int fits = 0
        push(w, __mn_hist)
        delocal int w = 0
        j += 1
    until j == 32
    push(j, __mn_hist)
    delocal int j = 0
    delocal int w31 = 0
    delocal int w30 = 0
    delocal int w29 = 0
    delocal int w28 = 0
    delocal int w27 = 0
    delocal int w26 = 0
    delocal int w25 = 0
    delocal int w24 = 0
    delocal int w23 = 0
    delocal int w22 = 0
    delocal int w21 = 0
    delocal int w20 = 0
    delocal int w19 = 0
    delocal int w18 = 0
    delocal int w17 = 0
    delocal int w16 = 0
    delocal int w15 = 0
    delocal int w14 = 0
    delocal int w13 = 0
    delocal int w12 = 0
    delocal int w11 = 0
    delocal int w10 = 0
    delocal int w9 = 0
    delocal int w8 = 0
    delocal int w7 = 0
    delocal int w6 = 0
    delocal int w5 = 0
    delocal int w4 = 0
    delocal int w3 = 0
    delocal int w2 = 0
    delocal int w1 = 0
    delocal int w0 = 0


// q = floor(t/2) con semantica divisione intera C su int; azzera t.
// `ts` copia stabile di t per il guard if/fi: nel ramo else t viene azzerato
// da move_int, quindi `fi t >= 0` sarebbe sempre TRUE — ts non viene toccato nei rami.
procedure __mn_floor_div2_signed(int t, int q, stack __mn_hist, stack __mn_scratch)
    local int r = 0
    local int ts = 0
    ts += t
    if ts >= 0 then
        call __mn_divmod_nonneg_div2(t, q, r, __mn_hist, __mn_scratch)
    else
        local int u = 0
        u -= t
        u += 1
        call __mn_divmod_nonneg_div2(u, q, r, __mn_hist, __mn_scratch)
        local int z = 0
        z -= q
        push(q, __mn_hist)
        call __mn_move_int(q, z, __mn_hist, __mn_scratch)
        local int sink = 0
        call __mn_move_int(sink, t, __mn_hist, __mn_scratch)
        push(sink, __mn_hist)
        delocal int sink = 0
        push(z, __mn_hist)
        delocal int z = 0
        push(u, __mn_hist)
        delocal int u = 0
    fi ts >= 0
    push(ts, __mn_hist)
    delocal int ts = 0
    push(r, __mn_hist)
    delocal int r = 0

// Bit k (0=LSB) dopo k shift aritmetici su a (semantica come int C).
// `from i == 0` + guard: FROM vero solo a i=0 (pre-loop), falso a i=1..k-1.
procedure __mn_bit_k_signed(int a, int kk, int bit_out, stack __mn_hist, stack __mn_scratch)
    local int t = 0
    t += a
    local int i = 0
    local int kp1 = 0
    kp1 += kk
    kp1 += 1
    from i == 0 loop
        if i != 0 then
            local int q = 0
            call __mn_floor_div2_signed(t, q, __mn_hist, __mn_scratch)
            t += q
            push(q, __mn_hist)
            delocal int q = 0
        fi i != 0
        i += 1
    until i == kp1
    local int qf = 0
    local int rf = 0
    local int ts = 0
    ts += t
    if ts >= 0 then
        call __mn_divmod_nonneg_div2(t, qf, rf, __mn_hist, __mn_scratch)
        bit_out += rf
    else
        local int u = 0
        u -= t
        call __mn_divmod_nonneg_div2(u, qf, rf, __mn_hist, __mn_scratch)
        bit_out += rf
        push(u, __mn_hist)
        delocal int u = 0
    fi ts >= 0
    push(ts, __mn_hist)
    delocal int ts = 0
    push(rf, __mn_hist)
    delocal int rf = 0
    push(qf, __mn_hist)
    delocal int qf = 0
    push(kp1, __mn_hist)
    delocal int kp1 = 0
    push(i, __mn_hist)
    delocal int i = 0
    push(t, __mn_hist)
    delocal int t = 0

// dst += (a & b) — bit-a-bit su 31 iterazioni (LSB… , come interi con bit signed).
// Pattern FLATTENED: nested `if abit then if bbit then dst += pow fi fi` triggers
// VM uncall bug (inner inverse fires unconditionally when outer cond true). Use
// `s = abit + bbit; if s == 2 then dst += pow fi s == 2` instead — single-stmt
// body if-fi inverts cleanly.
procedure __mn_and_into(int dst, int a, int b, stack __mn_hist, stack __mn_scratch)
    local int k = 0
    local int pow = 1
    from k == 0 loop
        local int abit = 0
        local int bbit = 0
        call __mn_bit_k_signed(a, k, abit, __mn_hist, __mn_scratch)
        call __mn_bit_k_signed(b, k, bbit, __mn_hist, __mn_scratch)
        local int s = 0
        s += abit
        s += bbit
        if s == 2 then
            dst += pow
        fi s == 2
        s -= bbit
        s -= abit
        push(s, __mn_hist)
        delocal int s = 0
        k += 1
        local int next_pow = 0
        next_pow += pow
        next_pow += pow
        push(pow, __mn_hist)
        call __mn_move_int(pow, next_pow, __mn_hist, __mn_scratch)
        push(next_pow, __mn_hist)
        delocal int next_pow = 0
        push(bbit, __mn_hist)
        delocal int bbit = 0
        push(abit, __mn_hist)
        delocal int abit = 0
    until k == 31
    // Bit 31 (segno) in complemento a 2: contribuisce -2^31 (= -pow qui, pow==2^31).
    // Senza questo l'AND a 31 bit perdeva il bit segno (-1 & -1 → 2147483647).
    local int a31 = 0
    local int b31 = 0
    call __mn_bit_k_signed(a, k, a31, __mn_hist, __mn_scratch)
    call __mn_bit_k_signed(b, k, b31, __mn_hist, __mn_scratch)
    local int s31 = 0
    s31 += a31
    s31 += b31
    if s31 == 2 then
        dst -= pow
    fi s31 == 2
    s31 -= b31
    s31 -= a31
    push(s31, __mn_hist)
    delocal int s31 = 0
    push(b31, __mn_hist)
    delocal int b31 = 0
    push(a31, __mn_hist)
    delocal int a31 = 0
    push(pow, __mn_hist)
    delocal int pow = 0
    push(k, __mn_hist)
    delocal int k = 0

// dst += (a | b)
// `from k == 0`: stesso pattern di and_into.
procedure __mn_or_into(int dst, int a, int b, stack __mn_hist, stack __mn_scratch)
    local int k = 0
    local int pow = 1
    from k == 0 loop
        local int abit = 0
        local int bbit = 0
        call __mn_bit_k_signed(a, k, abit, __mn_hist, __mn_scratch)
        call __mn_bit_k_signed(b, k, bbit, __mn_hist, __mn_scratch)
        local int s = 0
        s += abit
        s += bbit
        if s != 0 then
            dst += pow
        fi s != 0
        k += 1
        local int next_pow = 0
        next_pow += pow
        next_pow += pow
        push(pow, __mn_hist)
        call __mn_move_int(pow, next_pow, __mn_hist, __mn_scratch)
        push(next_pow, __mn_hist)
        delocal int next_pow = 0
        push(s, __mn_hist)
        delocal int s = 0
        push(bbit, __mn_hist)
        delocal int bbit = 0
        push(abit, __mn_hist)
        delocal int abit = 0
    until k == 31
    // Bit 31 (segno) in complemento a 2: contribuisce -2^31 (= -pow, pow==2^31).
    // Senza questo l'OR a 31 bit perdeva il bit segno (-5 | 8 → 2147483643).
    local int a31 = 0
    local int b31 = 0
    call __mn_bit_k_signed(a, k, a31, __mn_hist, __mn_scratch)
    call __mn_bit_k_signed(b, k, b31, __mn_hist, __mn_scratch)
    local int s31 = 0
    s31 += a31
    s31 += b31
    if s31 != 0 then
        dst -= pow
    fi s31 != 0
    s31 -= b31
    s31 -= a31
    push(s31, __mn_hist)
    delocal int s31 = 0
    push(b31, __mn_hist)
    delocal int b31 = 0
    push(a31, __mn_hist)
    delocal int a31 = 0
    push(pow, __mn_hist)
    delocal int pow = 0
    push(k, __mn_hist)
    delocal int k = 0

// dst += (x << n), n >= 0
// NOTA BUG VM: `if n != 0 then [from-loop] fi` con n==0 in inversione esegue
// il corpo una volta → i finisce a -1. Workaround peel-loop disponibile ma
// rallenta opt-uncall ~22x. Encrypt usa n=8 sempre, quindi if-fi è OK.
// Per n=0 vedere c_test/uncall_bug_shl_n0.kairos.
procedure __mn_shl_into(int dst, int x, int n, stack __mn_hist, stack __mn_scratch)
    local int pow = 1
    local int i = 0
    if n != 0 then
        from i == 0 loop
            i += 1
            local int np = 0
            np += pow
            np += pow
            push(pow, __mn_hist)
            call __mn_move_int(pow, np, __mn_hist, __mn_scratch)
            push(np, __mn_hist)
            delocal int np = 0
        until i == n
    fi n != 0
    call __mn_mul_into(dst, x, pow, __mn_hist, __mn_scratch)
    push(i, __mn_hist)
    delocal int i = 0
    push(pow, __mn_hist)
    delocal int pow = 0

// Dimezzamento UNSIGNED di un cell a 64 bit puro (nessun opcode nativo):
// q += floor(unsigned64(x)/2); r += unsigned64(x) mod 2; x = 0 (consumato).
// Necessario perché __mn_shr_into (sotto) applica shift logico anche a bit
// pattern con high bit set (x < 0 come signed int64, ma rappresenta un
// valore unsigned grande — es. u32/u64 dopo mask/xor). Con x >= 0 coincide
// con __mn_divmod_nonneg_fast(x,2); con x < 0 serve la correzione:
//   x rappresenta (complemento a 2) il valore unsigned x_u = x + 2^64.
//   Sia ab = |x| (negazione sicura per ogni x tranne INT64_MIN, unico
//   valore la cui negazione trabocca in complemento a 2 — gestito a parte),
//   qab = ab/2, rab = ab%2. Allora:
//     floor(x_u/2) = floor(x/2) + 2^63 = 2^63 - qab - rab
//   (floor(x/2) per x negativo pari = -qab; dispari = -(qab+1); in entrambi
//   i casi -qab-rab). r_u (bit meno significativo) = rab sempre, perché in
//   complemento a 2 bit0(-y) = bit0(y) per ogni intero y.
//   2^63 non è rappresentabile come int64 positivo: lo si ottiene sempre
//   come p62+p62 solo DOPO aver sottratto qab+rab da un p62 "di scorta"
//   (delta = p62 - qab - rab, poi q_u = p62 + delta) così nessun risultato
//   intermedio supera mai 2^63-1 (max int64).
procedure __mn_uhalve64(int x, int q, int r, stack __mn_hist, stack __mn_scratch)
    local int two = 0
    two += 2
    // min64 = -2^63 (raddoppio sicuro da -1: resta negativo, mai overflow).
    // p62 = 2^62 (raddoppio sicuro da 1: resta positivo, mai overflow).
    local int min64 = 0
    min64 -= 1
    local int p62 = 1
    local int i = 0
    from i == 0 loop
        local int m2 = 0
        m2 += min64
        m2 += min64
        push(min64, __mn_hist)
        call __mn_move_int(min64, m2, __mn_hist, __mn_scratch)
        push(m2, __mn_hist)
        delocal int m2 = 0
        local int p2 = 0
        p2 += p62
        p2 += p62
        push(p62, __mn_hist)
        call __mn_move_int(p62, p2, __mn_hist, __mn_scratch)
        push(p2, __mn_hist)
        delocal int p2 = 0
        i += 1
    until i == 62
    local int is_min = 0
    if x == min64 then
        is_min += 1
    fi x == min64
    if is_min == 1 then
        // x = INT64_MIN: x_u = 2^63 esatto. q_u = 2^62, r_u = 0.
        q += p62
        local int sink = 0
        call __mn_move_int(sink, x, __mn_hist, __mn_scratch)
        push(sink, __mn_hist)
        delocal int sink = 0
    else
        local int neg = 0
        if x < 0 then
            neg += 1
        fi x < 0
        local int ab = 0
        if neg == 1 then
            ab -= x
        else
            ab += x
        fi neg == 1
        local int qab = 0
        local int rab = 0
        call __mn_divmod_nonneg_fast(ab, two, qab, rab, __mn_hist, __mn_scratch)
        if neg == 1 then
            local int delta = 0
            delta += p62
            delta -= qab
            delta -= rab
            q += delta
            q += p62
            push(delta, __mn_hist)
            delocal int delta = 0
            r += rab
        else
            q += qab
            r += rab
        fi neg == 1
        uncall __mn_divmod_nonneg_fast(ab, two, qab, rab, __mn_hist, __mn_scratch)
        delocal int rab = 0
        delocal int qab = 0
        if neg == 1 then
            ab += x
        else
            ab -= x
        fi neg == 1
        delocal int ab = 0
        local int sink2 = 0
        call __mn_move_int(sink2, x, __mn_hist, __mn_scratch)
        push(sink2, __mn_hist)
        delocal int sink2 = 0
        push(neg, __mn_hist)
        delocal int neg = 0
    fi is_min == 1
    push(is_min, __mn_hist)
    delocal int is_min = 0
    push(i, __mn_hist)
    delocal int i = 0
    push(p62, __mn_hist)
    delocal int p62 = 0
    push(min64, __mn_hist)
    delocal int min64 = 0
    two -= 2
    delocal int two = 0

// dst += (x >> n) unsigned (logical shift). Necessario per u32/u64 dove
// bit pattern del cell può avere high bit set (signed-negative); aritmetico
// >> sign-extende perdendo bit utili. __mn_uhalve64 usa semantica unsigned
// div2, puro (nessun opcode nativo — vedi sopra).
// NOTA BUG VM: stesso problema di __mn_shl_into per n==0. Encrypt usa n=8.
// Per n=0 vedere c_test/uncall_bug_shr_n0.kairos.
procedure __mn_shr_into(int dst, int x, int n, stack __mn_hist, stack __mn_scratch)
    local int t = 0
    t += x
    local int i = 0
    if n != 0 then
        from i == 0 loop
            i += 1
            local int qh = 0
            local int ph = 0
            call __mn_uhalve64(t, qh, ph, __mn_hist, __mn_scratch)
            t += qh
            push(ph, __mn_hist)
            delocal int ph = 0
            push(qh, __mn_hist)
            delocal int qh = 0
        until i == n
    fi n != 0
    dst += t
    push(i, __mn_hist)
    delocal int i = 0
    push(t, __mn_hist)
    delocal int t = 0
